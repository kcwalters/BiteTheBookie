@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <i class="fas fa-envelope-open-text fa-2x mb-2" style="color: var(--btb-primary);"></i>
                    <h2 class="fw-bold">Check Your Email</h2>
                    <p class="text-muted">
                        If an account exists for the email you entered, password reset
                        instructions have been sent.
                    </p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary mt-2">
                        Back to Log In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
