@model BiteTheBookie.ViewModels.AdminPickViewModel

@{
    ViewData["Title"] = "Enter Expert Pick";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-league="@Model.League">Admin Picks</a></li>
            <li class="breadcrumb-item active">New Pick</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="content-card">
                <div class="section-header mb-4">
                    <i class="fas fa-plus-circle me-2"></i>Enter Expert Pick
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="GameId" id="gameIdInput" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">League</label>
                        <select asp-for="League" class="form-select" id="leagueSelect">
                            <option value="NBA">NBA</option>
                            <option value="MLB">MLB</option>
                            <option value="NFL">NFL</option>
                        </select>
                        <span asp-validation-for="League" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="nbaGameDropdownContainer" style="display: none;">
                        <label class="form-label fw-semibold">Select Game</label>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="nbaGameDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                -- Select an NBA Game --
                            </button>
                            <ul class="dropdown-menu w-100" id="nbaGameDropdownMenu">
                                @foreach (var game in Model.AvailableNbaGames)
                                {
                                    <li>
                                        <a class="dropdown-item nba-game-item" href="#" data-value="@game.Value" data-away="@game.AwayCode" data-home="@game.HomeCode" data-away-name="@game.AwayName" data-home-name="@game.HomeName" data-gametime="@game.GameTime.ToString("o")">
                                            <img src="https://a.espncdn.com/i/teamlogos/nba/500/@(game.AwayCode).png" alt="@game.AwayName" style="width:28px;height:28px;margin-right:8px;" loading="lazy" />
                                            <img src="https://a.espncdn.com/i/teamlogos/nba/500/@(game.HomeCode).png" alt="@game.HomeName" style="width:28px;height:28px;margin-right:8px;" loading="lazy" />
                                            @game.Text
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                        @if (!Model.AvailableNbaGames.Any())
                        {
                            <div class="form-text text-warning">
                                <i class="fas fa-exclamation-triangle me-1"></i>No upcoming NBA games found. You can type a Game ID manually below.
                            </div>
                        }
                        <span asp-validation-for="GameId" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="mlbGameDropdownContainer" style="display: none;">
                        <label class="form-label fw-semibold">Select Game</label>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="mlbGameDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                -- Select an MLB Game --
                            </button>
                            <ul class="dropdown-menu w-100" id="mlbGameDropdownMenu">
                                @foreach (var game in Model.AvailableMlbGames)
                                {
                                    <li>
                                        <a class="dropdown-item mlb-game-item" href="#" data-value="@game.Value" data-away="@game.AwayCode" data-home="@game.HomeCode" data-away-name="@game.AwayName" data-home-name="@game.HomeName" data-gametime="@game.GameTime.ToString("o")">
                                            <img src="https://a.espncdn.com/i/teamlogos/mlb/500/@(game.AwayCode).png" alt="@game.AwayName" style="width:28px;height:28px;margin-right:8px;" loading="lazy" />
                                            <img src="https://a.espncdn.com/i/teamlogos/mlb/500/@(game.HomeCode).png" alt="@game.HomeName" style="width:28px;height:28px;margin-right:8px;" loading="lazy" />
                                            @game.Text
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                        @if (!Model.AvailableMlbGames.Any())
                        {
                            <div class="form-text text-warning">
                                <i class="fas fa-exclamation-triangle me-1"></i>No MLB games found for today. You can type a Game ID manually below.
                            </div>
                        }
                        <span asp-validation-for="GameId" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="gameIdTextContainer">
                        <label class="form-label fw-semibold">Game ID</label>
                        <input type="text" class="form-control" id="gameIdTextInput"
                               value="@Model.GameId" placeholder="e.g. bos-mil-20260328" />
                        <div class="form-text">Format: awaycode-homecode-YYYYMMDD</div>
                        <span asp-validation-for="GameId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AwayTeamName" class="form-label fw-semibold">Away Team</label>
                            <input asp-for="AwayTeamName" class="form-control" id="awayTeamInput" placeholder="e.g. Boston Celtics" />
                            <span asp-validation-for="AwayTeamName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HomeTeamName" class="form-label fw-semibold">Home Team</label>
                            <input asp-for="HomeTeamName" class="form-control" id="homeTeamInput" placeholder="e.g. Milwaukee Bucks" />
                            <span asp-validation-for="HomeTeamName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GameTime" class="form-label fw-semibold">Game Time (UTC)</label>
                        <input asp-for="GameTime" type="datetime-local" class="form-control" id="gameTimeInput" />
                        <span asp-validation-for="GameTime" class="text-danger"></span>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-3">
                        <label asp-for="PickType" class="form-label fw-semibold">Pick Type</label>
                        <select asp-for="PickType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="Spread">Spread</option>
                            <option value="Moneyline">Moneyline</option>
                            <option value="OverUnder">Over/Under</option>
                        </select>
                        <span asp-validation-for="PickType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PickSelection" class="form-label fw-semibold">Pick Selection</label>
                        <input asp-for="PickSelection" class="form-control"
                               placeholder="e.g. Lakers -3.5, Over 215.5, Red Sox ML" />
                        <span asp-validation-for="PickSelection" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Confidence" class="form-label fw-semibold">
                            Confidence <span id="confidenceDisplay" class="text-warning"></span>
                        </label>
                        <input asp-for="Confidence" type="range" class="form-range" min="1" max="5" step="1"
                               oninput="updateStars(this.value)" />
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Low</span>
                            <span>Medium</span>
                            <span>High</span>
                        </div>
                        <span asp-validation-for="Confidence" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Analysis" class="form-label fw-semibold">
                            Analysis / Reasoning
                            <span id="summarySpinner" class="ms-2" style="display: none;">
                                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                <small class="text-muted">Generating pregame summary...</small>
                            </span>
                        </label>
                        <textarea asp-for="Analysis" class="form-control" rows="5" id="analysisInput"
                                  placeholder="Write your expert analysis for this pick..."></textarea>
                        <span asp-validation-for="Analysis" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Save Pick
                        </button>
                        <a asp-action="Index" asp-route-league="@Model.League" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function updateStars(val) {
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += i <= val ? '★' : '☆';
                }
                var confEl = document.getElementById('confidenceDisplay');
                if (confEl) confEl.textContent = stars;
            }

            var confidenceEl = document.querySelector('[name="Confidence"]');
            if (confidenceEl) updateStars(confidenceEl.value);

            var leagueSelect = document.getElementById('leagueSelect');
            var nbaDropdownContainer = document.getElementById('nbaGameDropdownContainer');
            var mlbDropdownContainer = document.getElementById('mlbGameDropdownContainer');
            var gameIdTextContainer = document.getElementById('gameIdTextContainer');
            var nbaGameDropdownBtn = document.getElementById('nbaGameDropdownBtn');
            var nbaGameDropdownMenu = document.getElementById('nbaGameDropdownMenu');
            var nbaGameDropdown = document.getElementById('nbaGameDropdown');
            var mlbGameDropdownBtn = document.getElementById('mlbGameDropdownBtn');
            var mlbGameDropdownMenu = document.getElementById('mlbGameDropdownMenu');
            var gameIdInput = document.getElementById('gameIdInput');
            var gameIdTextInput = document.getElementById('gameIdTextInput');
            var awayTeamInput = document.getElementById('awayTeamInput');
            var homeTeamInput = document.getElementById('homeTeamInput');
            var gameTimeInput = document.getElementById('gameTimeInput');
            var analysisInput = document.getElementById('analysisInput');
            var summarySpinner = document.getElementById('summarySpinner');

            function toggleGameIdField() {
                var league = leagueSelect ? leagueSelect.value : null;
                var nbaHasGames = nbaGameDropdownMenu && nbaGameDropdownMenu.querySelectorAll('.nba-game-item').length > 0;
                var mlbHasGames = mlbGameDropdownMenu && mlbGameDropdownMenu.querySelectorAll('.mlb-game-item').length > 0;

                if (nbaDropdownContainer) nbaDropdownContainer.style.display = 'none';
                if (mlbDropdownContainer) mlbDropdownContainer.style.display = 'none';
                if (gameIdTextContainer) gameIdTextContainer.style.display = 'none';

                if (league === 'NBA' && nbaHasGames) {
                    if (nbaDropdownContainer) nbaDropdownContainer.style.display = 'block';
                } else if (league === 'MLB' && mlbHasGames) {
                    if (mlbDropdownContainer) mlbDropdownContainer.style.display = 'block';
                } else {
                    if (gameIdTextContainer) gameIdTextContainer.style.display = 'block';
                }
            }

            if (gameIdTextInput && gameIdInput) {
                gameIdTextInput.addEventListener('input', function () {
                    gameIdInput.value = this.value;
                });
            }

            if (leagueSelect) {
                toggleGameIdField();

                leagueSelect.addEventListener('change', function () {
                    toggleGameIdField();
                    if (gameIdInput) gameIdInput.value = '';
                    if (gameIdTextInput) gameIdTextInput.value = '';
                    if (nbaGameDropdownBtn) nbaGameDropdownBtn.textContent = '-- Select an NBA Game --';
                    if (mlbGameDropdownBtn) mlbGameDropdownBtn.textContent = '-- Select an MLB Game --';
                    if (awayTeamInput) awayTeamInput.value = '';
                    if (homeTeamInput) homeTeamInput.value = '';
                    if (gameTimeInput) gameTimeInput.value = '';
                    if (analysisInput) analysisInput.value = '';
                });
            }

            function onGameSelected(league, selectedGameId) {
                if (gameIdInput) gameIdInput.value = selectedGameId;
                if (!selectedGameId) {
                    if (awayTeamInput) awayTeamInput.value = '';
                    if (homeTeamInput) homeTeamInput.value = '';
                    if (gameTimeInput) gameTimeInput.value = '';
                    return;
                }
                var url = '@Url.Action("GetGameDetails", "AdminPicks")'
                    + '?league=' + encodeURIComponent(league)
                    + '&gameId=' + encodeURIComponent(selectedGameId);
                fetch(url)
                    .then(function (response) {
                        if (!response.ok) throw new Error('Game not found');
                        return response.json();
                    })
                    .then(function (data) {
                        if (awayTeamInput) awayTeamInput.value = data.awayTeamName;
                        if (homeTeamInput) homeTeamInput.value = data.homeTeamName;
                        if (gameTimeInput) gameTimeInput.value = data.gameTime;
                    })
                    .catch(function (err) {
                        console.warn('Could not load game details:', err);
                    });
            }

            function loadMlbPregameSummary(gameId) {
                if (!gameId) return;
                if (summarySpinner) summarySpinner.style.display = 'inline';
                if (analysisInput) analysisInput.value = '';
                var url = '@Url.Action("GetMlbPregameSummary", "AdminPicks")'
                    + '?gameId=' + encodeURIComponent(gameId);
                fetch(url)
                    .then(function (response) {
                        if (!response.ok) throw new Error('Summary unavailable');
                        return response.json();
                    })
                    .then(function (data) {
                        if (analysisInput) analysisInput.value = data.summary;
                    })
                    .catch(function (err) {
                        console.warn('Could not load pregame summary:', err);
                        if (analysisInput) analysisInput.value = '';
                    })
                    .finally(function () {
                        if (summarySpinner) summarySpinner.style.display = 'none';
                    });
            }

            if (nbaGameDropdown) {
                nbaGameDropdown.addEventListener('change', function () {
                    onGameSelected('NBA', this.value);
                });
            }

            if (nbaGameDropdownMenu) {
                nbaGameDropdownMenu.addEventListener('click', function (e) {
                    var a = e.target.closest('.nba-game-item');
                    if (!a) return;
                    e.preventDefault();
                    var val = a.getAttribute('data-value');
                    var away = a.getAttribute('data-away-name') || a.getAttribute('data-away');
                    var home = a.getAttribute('data-home-name') || a.getAttribute('data-home');
                    var gtime = a.getAttribute('data-gametime');

                    if (nbaGameDropdownBtn) nbaGameDropdownBtn.textContent = a.textContent.trim();
                    if (gameIdInput) gameIdInput.value = val || '';
                    if (awayTeamInput) awayTeamInput.value = away || '';
                    if (homeTeamInput) homeTeamInput.value = home || '';

                    if (gtime) {
                        try { if (gameTimeInput) gameTimeInput.value = new Date(gtime).toISOString().slice(0, 16); } catch (ex) { if (gameTimeInput) gameTimeInput.value = ''; }
                    } else {
                        if (gameTimeInput) gameTimeInput.value = '';
                    }

                    onGameSelected('NBA', val);
                });
            }

            if (mlbGameDropdownMenu) {
                mlbGameDropdownMenu.addEventListener('click', function (e) {
                    var a = e.target.closest('.mlb-game-item');
                    if (!a) return;
                    e.preventDefault();
                    var val = a.getAttribute('data-value');
                    var away = a.getAttribute('data-away-name') || a.getAttribute('data-away');
                    var home = a.getAttribute('data-home-name') || a.getAttribute('data-home');
                    var gtime = a.getAttribute('data-gametime');

                    if (mlbGameDropdownBtn) mlbGameDropdownBtn.textContent = a.textContent.trim();
                    if (gameIdInput) gameIdInput.value = val || '';
                    if (awayTeamInput) awayTeamInput.value = away || '';
                    if (homeTeamInput) homeTeamInput.value = home || '';

                    if (gtime) {
                        try { if (gameTimeInput) gameTimeInput.value = new Date(gtime).toISOString().slice(0, 16); } catch (ex) { if (gameTimeInput) gameTimeInput.value = ''; }
                    } else {
                        if (gameTimeInput) gameTimeInput.value = '';
                    }

                    onGameSelected('MLB', val);
                    loadMlbPregameSummary(val);
                });
            }
        });
    </script>

    <script>
        // Diagnostic self-check: logs presence of key elements and (if supported) their event listeners.
        document.addEventListener('DOMContentLoaded', function () {
            try {
                var ids = ['leagueSelect','nbaGameDropdown','nbaGameDropdownMenu','mlbGameDropdown','mlbGameDropdownMenu','gameIdInput','gameIdTextInput','awayTeamInput','homeTeamInput','gameTimeInput','analysisInput','summarySpinner','confidenceDisplay'];
                var present = {};
                ids.forEach(function(id){ present[id] = !!document.getElementById(id); });
                console.info('AdminPicks/Create element presence:');
                console.table(present);

                if (typeof getEventListeners === 'function') {
                    ids.forEach(function(id){
                        var el = document.getElementById(id);
                        if (!el) return;
                        var ev = getEventListeners(el);
                        if (ev && Object.keys(ev).length) console.info('Event listeners on', id, ev);
                    });
                } else {
                    console.info('getEventListeners() not available in this browser. Use Chrome DevTools for listener inspection.');
                }
            } catch (ex) {
                console.warn('AdminPicks diagnostic script failed:', ex);
            }
        });
    </script>
}