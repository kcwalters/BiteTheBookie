@model BiteTheBookie.ViewModels.AdminPickViewModel

@{
    ViewData["Title"] = "Edit Expert Pick";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-league="@Model.League">Admin Picks</a></li>
            <li class="breadcrumb-item active">Edit Pick</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="content-card">
                <div class="section-header mb-4">
                    <i class="fas fa-edit me-2"></i>Edit Pick — @Model.AwayTeamName @@@@ @Model.HomeTeamName
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="GameId" />
                    <input type="hidden" asp-for="League" />
                    <input type="hidden" asp-for="AwayTeamName" />
                    <input type="hidden" asp-for="HomeTeamName" />
                    <input type="hidden" asp-for="GameTime" />

                    <div class="alert alert-light border mb-4">
                        <strong>Game:</strong> @Model.AwayTeamName @@@@ @Model.HomeTeamName
                        <br />
                        <strong>Time:</strong> @Model.GameTime.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                        <br />
                        <strong>League:</strong> @Model.League
                    </div>

                    <div class="mb-3">
                        <label asp-for="PickType" class="form-label fw-semibold">Pick Type</label>
                        <select asp-for="PickType" class="form-select">
                            <option value="Spread">Spread</option>
                            <option value="Moneyline">Moneyline</option>
                            <option value="OverUnder">Over/Under</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PickSelection" class="form-label fw-semibold">Pick Selection</label>
                        <input asp-for="PickSelection" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Confidence" class="form-label fw-semibold">
                            Confidence <span id="confidenceDisplay" class="text-warning"></span>
                        </label>
                        <input asp-for="Confidence" type="range" class="form-range" min="1" max="5" step="1"
                               oninput="updateStars(this.value)" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Analysis" class="form-label fw-semibold">Analysis / Reasoning</label>
                        <textarea asp-for="Analysis" class="form-control" rows="5"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Update Pick
                        </button>
                        <a asp-action="Index" asp-route-league="@Model.League" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateStars(val) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                stars += i <= val ? '★' : '☆';
            }
            document.getElementById('confidenceDisplay').textContent = stars;
        }
        updateStars(document.querySelector('[name="Confidence"]').value);
    </script>
}