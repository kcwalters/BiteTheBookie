@model BiteTheBookie.ViewModels.AdminContentBlocksListViewModel

@{
    ViewData["Title"] = "Admin - Content Blocks";
}

<div class="container py-4">
    <div class="content-card mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="h2 mb-0">
                <i class="fas fa-code me-2 text-primary"></i>Content Blocks
            </h1>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Add Block
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="content-card">
        @if (Model.Blocks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Page</th>
                            <th>Region</th>
                            <th>Sport</th>
                            <th>Team</th>
                            <th class="text-center">Published</th>
                            <th class="text-center">Order</th>
                            <th>Added By</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var block in Model.Blocks)
                        {
                            <tr>
                                <td><span class="fw-semibold">@block.Name</span></td>
                                <td><span class="badge bg-info text-dark">@block.PageKey</span></td>
                                <td><span class="badge bg-secondary">@block.RegionKey</span></td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(block.Sport) ? "Any" : block.Sport)</td>
                                <td class="text-muted">@(string.IsNullOrWhiteSpace(block.Team) ? "Any" : block.Team)</td>
                                <td class="text-center">
                                    @if (block.IsPublished)
                                    {
                                        <span class="badge bg-success">Live</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hidden</span>
                                    }
                                </td>
                                <td class="text-center text-muted">@block.SortOrder</td>
                                <td class="text-muted small">@block.EnteredBy</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@block.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@block.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this content block?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-code fa-3x text-muted mb-3"></i>
                <p class="text-muted">No content blocks added yet.</p>
                <a asp-action="Create" class="btn btn-primary">Add First Block</a>
            </div>
        }
    </div>
</div>

<style>
    .table thead th {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
</style>
