@using BiteTheBookie.Models
@model IReadOnlyList<CFBTickerView>
@{
    bool AwayWinning(CFBTickerView g) => g.AwayScore.HasValue && g.HomeScore.HasValue && g.AwayScore > g.HomeScore;
    bool HomeWinning(CFBTickerView g) => g.AwayScore.HasValue && g.HomeScore.HasValue && g.HomeScore > g.AwayScore;
}
<div class="cbb-scoreboard">
    <div class="cbb-scoreboard-logo">
        <img src="~/img/icons/college-football (1).svg" alt="CFB" />
        <span>CFB</span>
    </div>
    <div class="cbb-scoreboard-track">
        @if (Model.Count == 0)
        {
            <div class="cbb-scoreboard-empty">Out of season or no games scheduled in the next 10 days</div>
        }
        @foreach (var g in Model)
        {
            var itemClass = g.IsLive ? "cbb-game live" : (g.IsFinal ? "cbb-game final" : "cbb-game");
            <div class="@itemClass">
                <div class="cbb-game-status">
                    @if (g.IsLive)
                    {
                        <span class="cbb-live-badge"><span class="cbb-live-dot"></span>LIVE</span>
                    }
                    <span class="cbb-game-status-text">@g.StatusText</span>
                </div>
                <div class="cbb-game-team @(AwayWinning(g) ? "winning" : "")">
                    @if (!string.IsNullOrWhiteSpace(g.AwayLogo))
                    {
                        <img class="team-logo" src="@g.AwayLogo" alt="@g.AwayTeam" decoding="async" />
                    }
                    <span class="team-name">@g.AwayTeam</span>
                    <span class="team-score">@((g.AwayScore?.ToString()) ?? "-")</span>
                </div>
                <div class="cbb-game-team @(HomeWinning(g) ? "winning" : "")">
                    @if (!string.IsNullOrWhiteSpace(g.HomeLogo))
                    {
                        <img class="team-logo" src="@g.HomeLogo" alt="@g.HomeTeam" decoding="async" />
                    }
                    <span class="team-name">@g.HomeTeam</span>
                    <span class="team-score">@((g.HomeScore?.ToString()) ?? "-")</span>
                </div>
            </div>
        }
    </div>
</div>
