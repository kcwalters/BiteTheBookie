@model BiteTheBookie.ViewModels.ScoresPageViewModel
@using BiteTheBookie.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<BiteTheBookie.Models.ApplicationUser> SignInManager
@inject UserManager<BiteTheBookie.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = $"{Model.LeagueName} Scores";
    var league = Model.LeagueName;
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var hasGameSimulationAccess = currentUser?.IsPro == true || currentUser?.AllAccessUser == true;
}

<div class="container scores-page py-3">

    <!-- Section header -->
    <div class="nfl-landing__header">
        <div class="d-flex align-items-center gap-2">
            <img src="@Model.LeagueLogo" alt="@league" class="nfl-landing__logo" />
            <span class="nfl-landing__title">@league Scores</span>
        </div>
        <ul class="nfl-landing__subnav">
            @if (!string.IsNullOrWhiteSpace(Model.TeamController))
            {
                <li><a asp-controller="@Model.TeamController" asp-action="Index">Home</a></li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.OddsAction))
            {
                <li><a asp-controller="@Model.OddsController" asp-action="@Model.OddsAction">Odds</a></li>
            }
            <li><a class="active" asp-controller="Scores" asp-action="League" asp-route-league="@Model.LeagueCode">Scores</a></li>
            @if (!string.IsNullOrWhiteSpace(Model.ExpertPicksLeague))
            {
                <li><a asp-controller="ExpertPicks" asp-action="Index" asp-route-league="@Model.ExpertPicksLeague">Experts</a></li>
            }
            <li><a href="/GameSimulation?league=@league">$ Game Simulation</a></li>
        </ul>
    </div>

    <!-- League switcher -->
    <ul class="scores-leagues">
        @foreach (var lg in Model.AvailableLeagues)
        {
            <li>
                <a class="@(string.Equals(lg.Code, Model.LeagueCode, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   asp-controller="Scores" asp-action="League" asp-route-league="@lg.Code">@lg.Name</a>
            </li>
        }
    </ul>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @{
        // Build one unified scoreboard from every source list, de-duplicated by GameId.
        var combinedGames = new List<NBAGameMatchup>();
        combinedGames.AddRange(Model.Games);
        combinedGames.AddRange(Model.TodayGames);
        combinedGames.AddRange(Model.NextGameDayGames);
        combinedGames.AddRange(Model.LastDayGames);

        var uniqueGames = combinedGames
            .GroupBy(g => !string.IsNullOrWhiteSpace(g.GameId)
                ? g.GameId
                : $"{g.AwayTeamName}@{g.HomeTeamName}:{g.GameTime.Ticks}")
            .Select(grp => grp.First())
            .ToList();

        // Next games at the top (live, then upcoming), past games below. Every group is ordered
        // in descending order (most recent/latest first) so current and upcoming games lead.
        var orderedGames = uniqueGames.Where(g => g.IsLive).OrderByDescending(g => g.GameTime)
            .Concat(uniqueGames.Where(g => g.IsScheduled).OrderByDescending(g => g.GameTime))
            .Concat(uniqueGames.Where(g => g.IsFinal).OrderByDescending(g => g.GameTime))
            .ToList();
    }

    <div class="nfl-games">
        <div class="nfl-games__title">
            <span>@league Scoreboard</span>
            <small class="text-muted">@Model.SelectedDateDisplay</small>
        </div>

        @if (orderedGames.Any())
        {
            <div class="scoreboard-controls">
                <div class="scoreboard-controls__group">
                    <i class="fas fa-search"></i>
                    <input type="text" id="sbSearch" class="form-control form-control-sm" placeholder="Filter by team..." autocomplete="off" />
                </div>
                <select id="sbStatus" class="form-select form-select-sm">
                    <option value="all">All games</option>
                    <option value="upcoming">Upcoming</option>
                    <option value="live">Live</option>
                    <option value="final">Final / Past</option>
                </select>
                <select id="sbSort" class="form-select form-select-sm">
                    <option value="default">Next games first</option>
                    <option value="time-asc">Date: earliest first</option>
                    <option value="time-desc">Date: latest first</option>
                    <option value="away-az">Away team A–Z</option>
                    <option value="home-az">Home team A–Z</option>
                </select>
            </div>

            <div class="nfl-games__grid" id="scoreboardGrid">
                @foreach (var game in orderedGames)
                {
                    var statusKey = game.IsLive ? "live" : (game.IsFinal ? "final" : "upcoming");
                    <div class="nfl-game-card" data-status="@statusKey" data-time="@game.GameTime.Ticks"
                         data-teams="@($"{game.AwayTeamName} {game.HomeTeamName}".ToLowerInvariant())"
                         data-away="@game.AwayTeamName.ToLowerInvariant()" data-home="@game.HomeTeamName.ToLowerInvariant()">
                        <div class="nfl-game-card__status @(game.IsLive ? "is-live" : "")">
                            @(string.IsNullOrWhiteSpace(game.StatusDetail) ? (game.IsFinal ? "Final" : game.GameTimeDisplay) : game.StatusDetail)
                        </div>
                        <div class="nfl-game-card__row">
                            <div class="nfl-game-card__team">
                                @if (!string.IsNullOrWhiteSpace(game.AwayTeamLogo))
                                {
                                    <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" />
                                }
                                <span>@game.AwayTeamName</span>
                            </div>
                            <span class="nfl-game-card__score">@(game.AwayScore?.ToString() ?? "")</span>
                        </div>
                        <div class="nfl-game-card__row">
                            <div class="nfl-game-card__team">
                                @if (!string.IsNullOrWhiteSpace(game.HomeTeamLogo))
                                {
                                    <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" />
                                }
                                <span>@game.HomeTeamName</span>
                            </div>
                            <span class="nfl-game-card__score">@(game.HomeScore?.ToString() ?? "")</span>
                        </div>
                        <div class="mt-2 text-end">
                            @if (hasGameSimulationAccess)
                            {
                                <a class="btn btn-sm btn-primary" asp-controller="GameSimulation" asp-action="Start"
                                   asp-route-homeTeam="@game.HomeTeamName" asp-route-awayTeam="@game.AwayTeamName" asp-route-league="@Model.LeagueCode">
                                    Simulate Game
                                </a>
                            }
                            else if (SignInManager.IsSignedIn(User))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Membership" asp-action="Join">
                                    $ Game Simulation
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                                    $ Game Simulation
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="nfl-games__empty" id="scoreboardNoResults" style="display:none;">
                <img src="@Model.LeagueLogo" alt="@league" />
                <p class="mb-0 text-muted">No games match your filters.</p>
            </div>
        }
        else
        {
            <div class="nfl-games__empty">
                <img src="@Model.LeagueLogo" alt="@league" />
                <p class="mb-0 text-muted">No @league games scheduled for today. Check back on game day.</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .nfl-landing__header {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 12px;
            border-bottom: 3px solid var(--primary-blue, #013369);
            padding-bottom: 10px; margin-bottom: 18px;
        }
        .nfl-landing__logo { width: 40px; height: 40px; object-fit: contain; }
        .nfl-landing__title { font-size: 1.9rem; font-weight: 800; color: #0b0c0d; letter-spacing: .5px; }
        .nfl-landing__subnav { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; flex-wrap: wrap; }
        .nfl-landing__subnav a {
            display: inline-block; padding: 8px 14px; color: #444; font-weight: 600;
            text-decoration: none; border-radius: 6px; font-size: .95rem;
        }
        .nfl-landing__subnav a:hover { background: #eef2f6; color: #013369; }
        .nfl-landing__subnav a.active { color: #013369; border-bottom: 3px solid #d50a0a; border-radius: 0; }

        /* League switcher */
        .scores-leagues { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; padding: 0; }
        .scores-leagues a {
            display: inline-block; padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 20px;
            color: #444; font-weight: 700; text-decoration: none; font-size: .9rem; background: #fff;
        }
        .scores-leagues a:hover { background: #f5f8fb; color: #013369; border-color: #013369; }
        .scores-leagues a.active { background: var(--primary-blue, #013369); color: #fff; border-color: #013369; }

        /* Games */
        .nfl-games { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
        .nfl-games__title {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--primary-blue, #013369); color: #fff; padding: 12px 16px;
            font-weight: 800; text-transform: uppercase; letter-spacing: .5px;
        }
        .nfl-games__title small { color: rgba(255,255,255,.75) !important; font-weight: 600; text-transform: none; }
        .nfl-games__grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 14px; padding: 16px;
        }
        .nfl-game-card { border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; background: #fbfcfe; }
        .nfl-game-card__status { font-size: .78rem; font-weight: 700; color: #6b7280; text-transform: uppercase; margin-bottom: 8px; }
        .nfl-game-card__status.is-live { color: #d50a0a; }
        .nfl-game-card__row { display: flex; align-items: center; justify-content: space-between; padding: 4px 0; }
        .nfl-game-card__team { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .nfl-game-card__team img { width: 28px; height: 28px; object-fit: contain; }
        .nfl-game-card__team span { font-weight: 600; color: #111; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .nfl-game-card__score { font-weight: 800; color: #111; font-size: 1.05rem; }
        .nfl-games__empty { text-align: center; padding: 36px 16px; }
        .nfl-games__empty img { width: 54px; height: 54px; opacity: .4; margin-bottom: 10px; }

        /* Scoreboard filter/sort controls */
        .scoreboard-controls {
            display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
            padding: 12px 16px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;
        }
        .scoreboard-controls__group { display: flex; align-items: center; gap: 8px; flex: 1 1 220px; min-width: 200px; }
        .scoreboard-controls__group i { color: #6b7280; }
        .scoreboard-controls select { width: auto; min-width: 160px; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById('scoreboardGrid');
            if (!grid) return;

            var search = document.getElementById('sbSearch');
            var statusFilter = document.getElementById('sbStatus');
            var sortSelect = document.getElementById('sbSort');
            var noResults = document.getElementById('scoreboardNoResults');
            var cards = Array.prototype.slice.call(grid.querySelectorAll('.nfl-game-card'));

            // Preserve the server's default "next games first" order.
            cards.forEach(function (card, i) { card.dataset.defaultOrder = i; });

            // Restore any previously selected filter/sort from the URL.
            var params = new URLSearchParams(window.location.search);
            if (params.has('q')) { search.value = params.get('q'); }
            if (params.has('status') && statusFilter.querySelector('option[value="' + params.get('status') + '"]')) {
                statusFilter.value = params.get('status');
            }
            if (params.has('sort') && sortSelect.querySelector('option[value="' + params.get('sort') + '"]')) {
                sortSelect.value = params.get('sort');
            }

            function updateUrl() {
                var p = new URLSearchParams(window.location.search);
                var term = (search.value || '').trim();
                if (term) { p.set('q', term); } else { p.delete('q'); }
                if (statusFilter.value && statusFilter.value !== 'all') { p.set('status', statusFilter.value); } else { p.delete('status'); }
                if (sortSelect.value && sortSelect.value !== 'default') { p.set('sort', sortSelect.value); } else { p.delete('sort'); }

                var query = p.toString();
                var newUrl = window.location.pathname + (query ? '?' + query : '') + window.location.hash;
                window.history.replaceState(null, '', newUrl);
            }

            function applyFilters() {
                var term = (search.value || '').trim().toLowerCase();
                var status = statusFilter.value;
                var visible = 0;

                cards.forEach(function (card) {
                    var matchesTerm = !term || (card.dataset.teams || '').indexOf(term) !== -1;
                    var matchesStatus = status === 'all' || card.dataset.status === status;
                    var show = matchesTerm && matchesStatus;
                    card.style.display = show ? '' : 'none';
                    if (show) { visible++; }
                });

                if (noResults) { noResults.style.display = visible === 0 ? '' : 'none'; }
            }

            function applySort() {
                var mode = sortSelect.value;
                var sorted = cards.slice();

                sorted.sort(function (a, b) {
                    switch (mode) {
                        case 'time-asc':
                            return Number(a.dataset.time) - Number(b.dataset.time);
                        case 'time-desc':
                            return Number(b.dataset.time) - Number(a.dataset.time);
                        case 'away-az':
                            return (a.dataset.away || '').localeCompare(b.dataset.away || '');
                        case 'home-az':
                            return (a.dataset.home || '').localeCompare(b.dataset.home || '');
                        default:
                            return Number(a.dataset.defaultOrder) - Number(b.dataset.defaultOrder);
                    }
                });

                sorted.forEach(function (card) { grid.appendChild(card); });
            }

            search.addEventListener('input', function () { applyFilters(); updateUrl(); });
            statusFilter.addEventListener('change', function () { applyFilters(); updateUrl(); });
            sortSelect.addEventListener('change', function () { applySort(); updateUrl(); });

            // Apply restored state on load.
            applyFilters();
            applySort();
        })();
    </script>
}
