@using BiteTheBookie.Models.MLB
@model IReadOnlyList<Game>
@{
    bool IsLive(Game g) => g.Status.Contains("Progress", StringComparison.OrdinalIgnoreCase)
        || g.Status.Contains("In Prog", StringComparison.OrdinalIgnoreCase)
        || g.Status.Contains("Live", StringComparison.OrdinalIgnoreCase);
    bool IsFinal(Game g) => g.Status.Contains("Final", StringComparison.OrdinalIgnoreCase)
        || g.Status.Contains("Game Over", StringComparison.OrdinalIgnoreCase);
    bool AwayWinning(Game g) => g.AwayScore.HasValue && g.HomeScore.HasValue && g.AwayScore > g.HomeScore;
    bool HomeWinning(Game g) => g.AwayScore.HasValue && g.HomeScore.HasValue && g.HomeScore > g.AwayScore;
}
<div class="cbb-scoreboard">
    <div class="cbb-scoreboard-logo">
        <img src="~/img/mlb_logo.png" alt="MLB" />
        <span>MLB</span>
    </div>
    <div class="cbb-scoreboard-track">
        @if (Model.Count == 0)
        {
            <div class="cbb-scoreboard-empty">Out of season or no games scheduled in the next 10 days</div>
        }
        @foreach (var g in Model)
        {
            var live = IsLive(g);
            var final = IsFinal(g);
            var itemClass = live ? "cbb-game live" : (final ? "cbb-game final" : "cbb-game");
            var statusText = string.IsNullOrWhiteSpace(g.Status) ? g.GameTimeDisplay : g.Status;
            <div class="@itemClass">
                <div class="cbb-game-status">
                    @if (live)
                    {
                        <span class="cbb-live-badge"><span class="cbb-live-dot"></span>LIVE</span>
                    }
                    <span class="cbb-game-status-text">@statusText</span>
                </div>
                <div class="cbb-game-team @(AwayWinning(g) ? "winning" : "")">
                    @if (!string.IsNullOrWhiteSpace(g.AwayTeamLogoUrl))
                    {
                        <img class="team-logo" src="@g.AwayTeamLogoUrl" alt="@g.AwayTeam" decoding="async" />
                    }
                    <span class="team-name">@g.AwayTeam</span>
                    <span class="team-score">@((g.AwayScore?.ToString()) ?? "-")</span>
                </div>
                <div class="cbb-game-team @(HomeWinning(g) ? "winning" : "")">
                    @if (!string.IsNullOrWhiteSpace(g.HomeTeamLogoUrl))
                    {
                        <img class="team-logo" src="@g.HomeTeamLogoUrl" alt="@g.HomeTeam" decoding="async" />
                    }
                    <span class="team-name">@g.HomeTeam</span>
                    <span class="team-score">@((g.HomeScore?.ToString()) ?? "-")</span>
                </div>
            </div>
        }
    </div>
</div>
