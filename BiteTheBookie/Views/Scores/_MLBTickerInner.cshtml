@using BiteTheBookie.Models.MLB
@model IReadOnlyList<Game>
<div class="nfl-header-row">
    <img src="../img/mlb_logo.png" alt="MLB" class="league-logo" />
    <div class="nfl-ticker">
        <div class="nfl-ticker-track">
            @foreach (var g in Model)
            {
                <div class="nfl-ticker-item">
                    @if (!string.IsNullOrWhiteSpace(g.AwayTeamLogoUrl))
                    {
                        <img class="team-logo" src="@g.AwayTeamLogoUrl" alt="@g.AwayTeam" decoding="async" />
                    }
                    <span class="team-name">@g.AwayTeam</span>
                    <span class="team-score">@((g.AwayScore?.ToString()) ?? "-")</span>

                    <span class="vs">vs</span>

                    @if (!string.IsNullOrWhiteSpace(g.HomeTeamLogoUrl))
                    {
                        <img class="team-logo" src="@g.HomeTeamLogoUrl" alt="@g.HomeTeam" decoding="async" />
                    }
                    <span class="team-name">@g.HomeTeam</span>
                    <span class="team-score">@((g.HomeScore?.ToString()) ?? "-")</span>

                    <span class="game-date">@g.Status</span>
                </div>
            }
        </div>
    </div>
</div>
