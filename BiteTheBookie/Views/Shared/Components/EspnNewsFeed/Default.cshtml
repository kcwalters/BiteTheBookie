@using BiteTheBookie.ViewModels
@model IEnumerable<NewsItemViewModel>

<div class="latest-news-section" style="border-radius:12px; overflow:hidden; background-color:white; padding:16px; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
    <div style="text-align:center; font-size:14pt; font-weight:700; color:#fff; background-color:#111; padding:10px; border-radius:8px 8px 0 0; letter-spacing:0.2px;">
        Top Headlines
    </div>

    <div class="mt-3" style="font-size:12pt; color:#111;">
        @await Html.PartialAsync("~/Views/Shared/Partials/_NewsFeed.cshtml", Model)
    </div>
</div>
        