@using BiteTheBookie.ViewModels
@model IEnumerable<NewsItemViewModel>

<div class="latest-news-section espn-news-feed">
    <div class="espn-news-feed__title">
        @(ViewData["NewsTitle"] as string ?? "ESPN Headlines")
    </div>

    <div class="mt-3 espn-news-feed__content">
        @await Html.PartialAsync("~/Views/Shared/Partials/_NewsFeed.cshtml", Model)
    </div>
</div>
<link href="~/css/style.css" rel="stylesheet" />
