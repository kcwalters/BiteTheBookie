@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BiteTheBookie</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/picks.css" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="site-body">
    <header class="site-header">
        <div class="top-header">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="top-links d-flex align-items-center flex-wrap" style="gap:14px;">
                    <a asp-controller="Home" asp-action="Index" class="top-brand">BiteTheBookie</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports HQ</a>
                    <a href="https://247sports.com/" target="_blank" class="opacity-75">247Sports</a>
                    <a href="https://www.stubhub.com/" target="_blank" class="opacity-75">StubHub</a>
                    <a href="https://www.sportsline.com/sportsbooks/" target="_blank" class="opacity-75">Sportsbooks</a>
                    <a href="https://www.sportsline.com/casinos/" target="_blank" class="opacity-75">Casinos</a>
                </div>
                <div class="d-flex align-items-center" style="gap:12px;">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <a asp-controller="Membership" asp-action="MyAccount" class="d-flex align-items-center gap-1">
                            <i class="fas fa-user-circle"></i>
                            <span>@(user?.FirstName ?? User.Identity?.Name)</span>
                            @if (user?.IsPremium == true)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">
                                    @(user.SubscriptionTier == SubscriptionTier.VIP ? "VIP" : "PRO")
                                </span>
                            }
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout" 
                              asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0" style="color: inherit; text-decoration: none;">
                                Log Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login">Log In</a>
                        <a asp-controller="Membership" asp-action="Join" class="btn btn-sm btn-warning fw-bold">
                            <i class="fas fa-star me-1"></i>Join Now
                        </a>
                    }
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-inline-flex align-items-center gap-2">
                    <img src="~/img/slider-1.png" id="siteLogo" class="brand-logo" style="width:300px;height:auto;" alt="BiteTheBookie" />                   
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        
                        <!-- Picks Dropdown with Hover -->
                        <li class="nav-item dropdown picks-dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Picks
                            </a>
                            <ul class="dropdown-menu dropdown-menu-hover">
                                <li>
                                    <a class="dropdown-item" asp-controller="Picks" asp-action="index">
                                        <img src="~/img/NBALogoSmall.png" alt="NBA" class="league-icon" />
                                        <span>NBA Picks</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Picks" asp-action="CBB">
                                        <img src="~/img/NCAAMens_med.png" alt="NCAA" class="league-icon" />
                                        <span>NCAA Basketball</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Picks" asp-action="MLB">
                                        <img src="https://www.mlbstatic.com/team-logos/league-on-dark/1.svg" alt="MLB" class="league-icon" style="width: 24px;" />
                                        <span>MLB Picks</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item"><a class="nav-link" asp-controller="Odds" asp-action="Index">Odds</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Fantasy</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Experts</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Analysis</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="league-menu">
            <div class="container d-flex flex-wrap align-items-center" style="gap:18px;">
                <a href="#" data-league="nfl">NFL</a>
                <a href="#" data-league="nba">NBA</a>
                <a href="#" data-league="ncaa">CBB</a>
                <a href="#" data-league="mlb">MLB</a>
                <a href="#" data-league="nhl">NHL</a>
                <a href="#" class="opacity-75" aria-label="More leagues" title="More">&middot;&middot;&middot;</a>
            </div>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <!-- League Modals -->
    <div class="modal fade nfl-team-modal" id="nflTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="nbaTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="cbbTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="mlbTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="nhlTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/picks-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/nfl-team-modal.js" asp-append-version="true"></script>
    <script src="~/js/league-menu-ticker-switcher.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
