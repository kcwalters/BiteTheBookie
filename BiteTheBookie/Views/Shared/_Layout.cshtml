
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BiteTheBookie</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/cash-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/league-nav-dropdown.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/home-styles.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/league-nav-dropdown.js" asp-append-version="true" defer></script>

    <script>
        // Apply the saved theme before paint to avoid a flash of the wrong theme.
        (function () {
            try {
                if (localStorage.getItem('btb-theme') === 'cash') {
                    document.documentElement.classList.add('theme-cash');
                }
            } catch (e) { }
        })();
    </script>

    <style>
        .sim-processing-overlay {
            position: fixed;
            inset: 0;
            z-index: 20000;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(10, 14, 22, 0.72);
            backdrop-filter: blur(3px);
        }

        .sim-processing-overlay.is-visible {
            display: flex;
        }

        .sim-processing-box {
            text-align: center;
            background: #fff;
            color: #0d1117 !important;
            padding: 32px 40px;
            border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
            max-width: 420px;
            width: calc(100% - 40px);
        }

        .sim-processing-spinner {
            width: 3rem;
            height: 3rem;
        }

        .sim-processing-box .sim-processing-title {
            font-weight: 700;
            color: #0d1117 !important;
            opacity: 1 !important;
            -webkit-text-fill-color: #0d1117 !important;
            background: none !important;
            -webkit-background-clip: border-box !important;
            background-clip: border-box !important;
            text-shadow: none !important;
        }

        .sim-processing-box .sim-processing-text {
            color: #2b333f !important;
            opacity: 1 !important;
            -webkit-text-fill-color: #2b333f !important;
            background: none !important;
            text-shadow: none !important;
            font-size: 0.95rem;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <header class="site-header">
        <div class="top-header">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="top-links d-flex align-items-center flex-wrap" style="gap:14px;">
                    <a asp-controller="Home" asp-action="Index" class="top-brand">BiteTheBookie</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports HQ</a>
                    <a href="https://247sports.com/" target="_blank" class="opacity-75">247Sports</a>
                    <a href="https://www.stubhub.com/" target="_blank" class="opacity-75">StubHub</a>
                    <a href="https://www.sportsline.com/sportsbooks/" target="_blank" class="opacity-75">Sportsbooks</a>
                    <a href="https://www.sportsline.com/casinos/" target="_blank" class="opacity-75">Casinos</a>
                </div>
                <div class="d-flex align-items-center" style="gap:12px;">
                    <a href="https://www.facebook.com/" target="_blank" class="top-social" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="https://twitter.com/" target="_blank" class="top-social" aria-label="X"><i class="fab fa-x-twitter"></i></a>
                    <button type="button" id="themeToggleBtn" class="theme-toggle-btn" title="Switch theme">
                        <i class="fas fa-moon me-1"></i><span class="theme-toggle-label">Dark</span>
                    </button>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <a asp-controller="Membership" asp-action="MyAccount" class="d-flex align-items-center gap-1">
                            <i class="fas fa-user-circle"></i>
                            <span>@(user?.FirstName ?? User.Identity?.Name)</span>
                            @if (user?.IsPro == true)
                            {
                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">
                                    @(user.SubscriptionTier == SubscriptionTier.AllAccess ? "AllAccess" : "PRO")
                                </span>
                            }
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout" 
                              asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link p-0" style="color: inherit; text-decoration: none;">
                                Log Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Log In</a>
                        <a asp-controller="Membership" asp-action="Join" class="btn btn-sm btn-warning fw-bold">
                            <i class="fas fa-star me-1"></i>Join Now
                        </a>
                    }
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-inline-flex align-items-center gap-2">
                    <img src="~/img/slider-1.png" id="siteLogo" class="brand-logo" style="width:300px;height:auto;" alt="BiteTheBookie" />                   
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- Primary section links (SportsLine-style flat nav) -->
                    <ul class="navbar-nav primary-nav">
                        <li class="nav-item dropdown picks-dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Picks</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="NFL">NFL Picks</a>
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="NBA">NBA Picks</a>
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="MLB">MLB Picks</a>
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="NHL">NHL Picks</a>
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="CFB">CFB Picks</a>
                                <a class="dropdown-item" asp-controller="ExpertPicks" asp-action="Index" asp-route-league="CBB">CBB Picks</a>
                            </div>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Odds" asp-action="Index">Odds</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Fantasy" asp-action="Index">Fantasy</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Experts" asp-action="Index">Experts</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Analysis</a></li>
                    </ul>

                    <!-- League quick-links with icons; also drives the ticker switcher -->
                    <ul class="navbar-nav league-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="NFL" asp-action="Index" data-league="nfl">
                                <img src="https://a.espncdn.com/i/teamlogos/leagues/500/nfl.png" alt="" class="league-icon" />
                                <span>NFL</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="MLB" asp-action="Index" data-league="mlb">
                                <img src="https://a.espncdn.com/i/teamlogos/leagues/500/mlb.png" alt="" class="league-icon" />
                                <span>MLB</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="NBA" asp-action="Index" data-league="nba">
                                <img src="https://a.espncdn.com/i/teamlogos/leagues/500/nba.png" alt="" class="league-icon" />
                                <span>NBA</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="NHL" asp-action="Index" data-league="nhl">
                                <img src="https://a.espncdn.com/i/teamlogos/leagues/500/nhl.png" alt="" class="league-icon" />
                                <span>NHL</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="CollegeBasketball" asp-action="Index" data-league="ncaa">
                                <img src="~/img/NCAAMens_med.png" alt="" class="league-icon" />
                                <span>CBB</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-link" asp-controller="CollegeFootball" asp-action="Index" data-league="ncaaf">
                                <img src="~/img/NCAAMens_med.png" alt="" class="league-icon" />
                                <span>CFB</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link league-more" href="#" aria-label="More leagues" title="More">&middot;&middot;&middot;</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-page="/Admin/ManageRoles">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="ExpertPicks" asp-action="Manage">
                                    <i class="fas fa-clipboard-list me-1"></i>Admin Picks
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="AdminVideos" asp-action="Index">
                                    <i class="fab fa-youtube me-1"></i>Videos
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global ticker row — league menu switches visibility -->
    <div class="container">
        <div class="tickers-row">
            <div id="nfl-ticker" style="display: none;">
                @await Component.InvokeAsync("NFLTicker")
            </div>
            <div id="nba-ticker" style="display: none;">
                @await Component.InvokeAsync("NBATicker")
            </div>
            <div id="nhl-ticker" style="display: none;">
                @await Component.InvokeAsync("NHLTicker")
            </div>
            <div id="ncaa-ticker" style="display: none;">
                @await Component.InvokeAsync("NCAATicker")
            </div>
            <div id="ncaaf-ticker" style="display: none;">
                @await Component.InvokeAsync("CFBTicker")
            </div>
            <div id="mlb-ticker" style="display: none;">
                @await Component.InvokeAsync("MLBTicker")
            </div>
        </div>
    </div>

    <main class="site-main">
        @RenderBody()
    </main>

    <!-- League Modals -->
    <div class="modal fade nfl-team-modal" id="nflTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="nbaTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="cbbTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="cfbTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>


    <div class="modal fade nfl-team-modal" id="mlbTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade nfl-team-modal" id="nhlTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <div id="simProcessingOverlay" class="sim-processing-overlay" aria-hidden="true" role="alert" aria-live="assertive">
        <div class="sim-processing-box">
            <div class="spinner-border text-primary sim-processing-spinner" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h5 class="sim-processing-title mt-3 mb-1">Running Game Simulation</h5>
            <p class="sim-processing-text mb-0">Our AI is crunching the numbers &mdash; this can take a few moments. Please wait&hellip;</p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tickers.js" asp-append-version="true"></script>
    <script src="~/js/picks-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/nfl-team-modal.js" asp-append-version="true"></script>
    <script src="~/js/league-menu-ticker-switcher.js" asp-append-version="true"></script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>

    <script>
        (function () {
            var overlay = document.getElementById('simProcessingOverlay');
            if (!overlay) return;

            function showSimOverlay() {
                overlay.classList.add('is-visible');
                overlay.setAttribute('aria-hidden', 'false');
            }

            // Show the overlay whenever a Game Simulation is started/regenerated.
            document.addEventListener('click', function (e) {
                var trigger = e.target.closest('[data-sim-trigger], a[href*="/GameSimulation"]');
                if (!trigger) return;
                if (trigger.tagName === 'A' && (trigger.target === '_blank' || e.defaultPrevented)) return;
                showSimOverlay();
            }, true);

            document.addEventListener('submit', function (e) {
                var form = e.target;
                if (form && form.matches && form.matches('[data-sim-form], form[action*="/GameSimulation"]')) {
                    showSimOverlay();
                }
            }, true);

            // Hide overlay if the user navigates back to a cached page.
            window.addEventListener('pageshow', function () {
                overlay.classList.remove('is-visible');
                overlay.setAttribute('aria-hidden', 'true');
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>