@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BiteTheBookie</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
</head>

<body class="site-body">
    <header class="site-header">
        <div class="top-header">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="top-links d-flex align-items-center flex-wrap" style="gap:14px;">
                    <a asp-controller="Home" asp-action="Index" class="top-brand">BiteTheBookie</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports</a>
                    <a href="https://www.cbssports.com/" target="_blank" class="opacity-75">CBS Sports HQ</a>
                    <a href="https://247sports.com/" target="_blank" class="opacity-75">247Sports</a>
                    <a href="https://www.stubhub.com/" target="_blank" class="opacity-75">StubHub</a>
                    <a href="https://www.sportsline.com/sportsbooks/" target="_blank" class="opacity-75">Sportsbooks</a>
                    <a href="https://www.sportsline.com/casinos/" target="_blank" class="opacity-75">Casinos</a>
                </div>

                <div class="d-flex align-items-center" style="gap:12px;">
                    <a asp-area="Identity" asp-page="/Account/Login">Log In</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="fw-semibold">Become A Member</a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-inline-flex align-items-center gap-2">
                    <img src="~/img/slider-1.png" id="siteLogo" class="brand-logo" style="width:300px;height:auto;" alt="BiteTheBookie" />                   
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Picks</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Odds" asp-action="Index">Odds</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Fantasy</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Experts</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Analysis</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="league-menu">
            <div class="container d-flex flex-wrap align-items-center" style="gap:18px;">
                <a href="#" data-league="nfl">NFL</a>
                <a href="#" data-league="nba">NBA</a>
                <a href="#" data-league="ncaa">CBB</a>
                <a href="#" data-league="nhl">NHL</a>
                <a href="#">UCL</a>
                <a href="#">ECL</a>
                <a href="#" class="opacity-75" aria-label="More leagues" title="More">&middot;&middot;&middot;</a>
            </div>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <div class="modal fade nfl-team-modal" id="nflTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body"></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ticker-autoscroll-control.js" asp-append-version="true"></script>
    <script src="~/js/ticker-carousel.js" asp-append-version="true"></script>
    <script src="~/js/league-menu-ticker-switcher.js" asp-append-version="true"></script>
    <script src="~/js/nfl-team-modal.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
