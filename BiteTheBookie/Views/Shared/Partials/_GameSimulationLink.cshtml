@model BiteTheBookie.ViewModels.GameSimulationLinkViewModel
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isPaid = false;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        // Any subscription level above Free can create simulations. Admins
        // (via the Identity role or the Admin tier) always have access.
        isPaid = User.IsInRole("Admin") ||
                 (currentUser != null &&
                  currentUser.SubscriptionTier != SubscriptionTier.Free);
    }
}

@if (Model.IsFinal)
{
    // Game is over; a simulation is not applicable, so render nothing.
}
else if (isPaid)
{
    <a class="btn btn-sm btn-primary"
       asp-controller="GameSimulation" asp-action="Start"
       asp-route-homeTeam="@Model.HomeTeam" asp-route-awayTeam="@Model.AwayTeam" asp-route-league="@Model.League">
        <i class="fa-solid fa-computer"></i> Game Simulation
    </a>
}
else
{
    <a class="btn btn-sm btn-outline-primary" asp-controller="Membership" asp-action="Join">
        <i class="fa-solid fa-dollar-sign"></i> Game Simulation
    </a>
}
