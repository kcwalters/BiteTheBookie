@using BiteTheBookie.ViewModels;
@model IEnumerable<NewsItemViewModel>
<div class="list-group">
    @foreach (var item in Model)
    {
        <a class="list-group-item list-group-item-action mb-2" href="@item.ArticleUrl">
            <div class="d-flex">
                <img src="@item.ImageUrl" class="me-3" style="width:80px;height:60px;" />
                <div>
                    <h5>@item.Title</h5>
                    <p class="mb-0 text-secondary">@item.Excerpt</p>
                </div>
            </div>
        </a>
    }
</div>
