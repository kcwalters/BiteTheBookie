@model BiteTheBookie.ViewModels.HomePageViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>BiteTheBookie — Sports Odds</title>
    <link rel="icon" href="~/img/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/home-styles.css" />
</head>
<body class="bg-dark text-light">

    <header class="border-bottom bg-black py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="h4 text-success text-decoration-none" href="/">BiteTheBookie</a>
            <nav class="d-flex gap-3">
                <a class="nav-link text-light" href="#">NFL</a>
                <a class="nav-link text-light" href="#">NBA</a>
                <a class="nav-link text-light" href="#">Live Odds</a>
                <a class="nav-link text-light" href="#">Props</a>
            </nav>
            <div>
                <a class="btn btn-outline-light btn-sm" asp-area="Identity" asp-page="/Account/Login">Login</a>
                <a class="btn btn-success btn-sm" asp-area="Identity" asp-page="/Account/Register">Join Free</a>
            </div>
        </div>
    </header>

    <main class="container my-4">
        <!-- Picks -->
        <section class="card bg-secondary mb-4">
            <div class="card-header">
                <h5 class="mb-0">NFL Week 13 Picks & Predicted Scores</h5>
                <small class="text-muted">Professional slate overview • Lines shown as team and spread pick</small>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Matchup</th>
                            <th>Pick (spread)</th>
                            <th>Predicted Score</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Packers at Lions</td><td><span class="badge bg-success">Favorite</span> Lions (-2.5)</td><td><strong>DET 26 – GB 21</strong></td><td>Detroit’s home scoring edge; GB WRs can create chunk plays.</td></tr>
                        <tr><td>Chiefs at Cowboys</td><td><span class="badge bg-success">Favorite</span> Cowboys (-2.5)</td><td><strong>DAL 27 – KC 20</strong></td><td>KC more methodical than explosive; Dallas defense strongest at home.</td></tr>
                        <tr><td>Bengals at Ravens</td><td><span class="badge bg-success">Favorite</span> Ravens (-3.5)</td><td><strong>BAL 28 – CIN 24</strong></td><td>Ravens’ balanced offense; late surge edge at home.</td></tr>
                        <tr><td>Bears at Eagles</td><td><span class="badge bg-success">Favorite</span> Eagles (-6.5)</td><td><strong>PHI 30 – CHI 20</strong></td><td>Eagles control line of scrimmage; Bears struggle to sustain drives.</td></tr>
                        <tr><td>49ers at Browns</td><td><span class="badge bg-success">Favorite</span> 49ers (-4.5)</td><td><strong>SF 27 – CLE 23</strong></td><td>49ers’ scheme versatility vs. Browns’ physical defense.</td></tr>
                        <tr><td>Rams at Panthers</td><td><span class="badge bg-success">Favorite</span> Rams (-3.5)</td><td><strong>LAR 24 – CAR 17</strong></td><td>Rams’ passing structure vs. Panthers’ rebuilding offense.</td></tr>
                        <tr><td>Texans at Colts</td><td><span class="badge bg-success">Favorite</span> Texans (-2.5)</td><td><strong>HOU 28 – IND 21</strong></td><td>Potential upset narrative flipped; Texans’ QB play edges out.</td></tr>
                        <tr><td>Dolphins at Saints</td><td><span class="badge bg-success">Favorite</span> Dolphins (-5.5)</td><td><strong>MIA 31 – NO 20</strong></td><td>Explosive Dolphins offense vs. Saints’ red zone inconsistencies.</td></tr>
                        <tr><td>Patriots at Giants (Mon)</td><td><span class="badge bg-success">Favorite</span> Patriots (-1.5)</td><td><strong>NE 23 – NYG 17</strong></td><td>Lower-total profile; field position and special teams matter.</td></tr>
                        <tr><td>Vikings at Seahawks</td><td><span class="badge bg-success">Favorite</span> Seahawks (-10.5)</td><td><strong>SEA 27 – MIN 14</strong></td><td>Seattle’s defensive front sets the tone at home.</td></tr>
                        <tr><td>Broncos at Raiders</td><td><span class="badge bg-success">Favorite</span> Broncos (-3.5)</td><td><strong>DEN 24 – LV 20</strong></td><td>Divisional grind; Broncos’ late-game execution advantage.</td></tr>
                        <tr><td>Bills at Steelers</td><td><span class="badge bg-success">Favorite</span> Bills (-4.5)</td><td><strong>BUF 27 – PIT 21</strong></td><td>Bills’ explosive plays vs. Steelers’ ball-control approach.</td></tr>
                        <tr><td>Titans at Jaguars</td><td><span class="badge bg-success">Favorite</span> Jaguars (-6.5)</td><td><strong>JAX 28 – TEN 17</strong></td><td>Jags’ passing attack vs. Titans’ inconsistent offense.</td></tr>
                        <tr><td>Cardinals at Jets</td><td><span class="badge bg-success">Favorite</span> Jets (-2.5)</td><td><strong>NYJ 23 – ARI 20</strong></td><td>Defense-led game; Jets squeeze enough offense at home.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Live Scoreboard -->
        <section class="card bg-secondary mb-4">
            <div class="card-header">
                <h5 class="mb-0">Live Scoreboard</h5>
                <small class="text-muted">NFL Week 13 Scores — Nov 30, 2025</small>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Game</th>
                            <th>Away</th>
                            <th>Away Score</th>
                            <th>Home</th>
                            <th>Home Score</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Jets vs Falcons</td><td>Falcons</td><td>24</td><td>Jets</td><td>24</td><td><span class="text-warning fw-bold">Q4 — 1:39 left</span></td></tr>
                        <tr><td>Colts vs Texans</td><td>Texans</td><td>20</td><td>Colts</td><td>16</td><td><span class="text-warning fw-bold">Q4 — 1:45 left</span></td></tr>
                        <tr><td>Dolphins vs Saints</td><td>Saints</td><td>17</td><td>Dolphins</td><td>21</td><td><span class="text-warning fw-bold">Q4 — 1:17 left</span></td></tr>
                        <tr><td>Titans vs Jaguars</td><td>Jaguars</td><td>25</td><td>Titans</td><td>3</td><td><span class="text-warning fw-bold">Q4 — 6:04 left</span></td></tr>
                        <tr><td>Browns vs 49ers</td><td>49ers</td><td>26</td><td>Browns</td><td>8</td><td><span class="text-success fw-bold
                        <tr><td>Browns vs 49ers</td><td>49ers</td><td>26</td><td>Browns</td><td>8</td><td><span class="text-success fw-bold">Final</span></td></tr>
                        <tr><td>Panthers vs Rams</td><td>Rams</td><td>28</td><td>Panthers</td><td>31</td><td><span class="text-success fw-bold">Final</span></td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <footer class="bg-black text-muted py-3 mt-5">
        <div class="container d-flex justify-content-between">
            <small>© 2025 BiteTheBookie</small>
            <small>Odds content for information only. Please bet responsibly.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
