@model BiteTheBookie.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="tickers-row">
        <div id="nfl-ticker">
            @await Component.InvokeAsync("NFLTicker")
        </div>
        <div id="nba-ticker">
            @await Component.InvokeAsync("NBATicker")
        </div>
        <div id="nhl-ticker">
            @await Component.InvokeAsync("NHLTicker")
        </div>
        <div id="ncaa-ticker">
            @await Component.InvokeAsync("NCAATicker")
        </div>
    </div>
</div>

<div class="container py-3">
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="content-card">
                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <iframe
                        src="https://www.youtube.com/embed/zsZPOtv9nvk"
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen>
                    </iframe>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="content-card">
                <div class="section-header">More Stories &amp; Analysis</div>
                @await Component.InvokeAsync("EspnNewsFeed", new { count = 20 })
            </div>
        </div>

        <div class="col-12">
           
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home-page.js" asp-append-version="true"></script>
}