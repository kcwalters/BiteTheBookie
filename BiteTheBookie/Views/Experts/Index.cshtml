@model List<ExpertPost>

@{
    ViewData["Title"] = "Expert Articles";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="h2 mb-0">
                    <i class="fas fa-lightbulb me-2"></i>Expert Articles
                </h1>
                <p class="text-muted mb-0 mt-1">Insights and analysis from our experts</p>
            </div>
            @if (User.IsInRole("Expert") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Write Article
                </a>
            }
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Articles List -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow">
                        <!-- Category Badge -->
                        @if (!string.IsNullOrEmpty(post.Category))
                        {
                            <div class="p-3 bg-light border-bottom">
                                <span class="badge bg-info">
                                    <i class="fas fa-tag me-1"></i>@post.Category
                                </span>
                            </div>
                        }

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                <a asp-action="Details" asp-route-id="@post.Id" 
                                   class="text-decoration-none text-dark">
                                    @post.Title
                                </a>
                            </h5>

                            @if (!string.IsNullOrEmpty(post.Summary))
                            {
                                <p class="card-text text-muted small mb-3">
                                    @post.Summary
                                </p>
                            }

                            <!-- Author and Date -->
                            <div class="mt-auto">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="small">
                                        @if (post.Author != null)
                                        {
                                            <div class="text-muted">
                                                <i class="fas fa-user-circle me-1"></i>
                                                @(post.Author.FirstName ?? "") @(post.Author.LastName ?? "")
                                            </div>
                                        }
                                        <div class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>
                                            @post.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                </div>

                                <!-- View Count -->
                                <div class="text-muted small mb-3">
                                    <i class="fas fa-eye me-1"></i>@post.ViewCount @(post.ViewCount == 1 ? "view" : "views")
                                </div>

                                <!-- Read More Button -->
                                <a asp-action="Details" asp-route-id="@post.Id" 
                                   class="btn btn-outline-primary btn-sm w-100">
                                    Read More <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Card Footer with Actions (for authors) -->
                        @if (User.IsInRole("Admin") || 
                             (User.Identity?.IsAuthenticated == true && post.AuthorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                        {
                            <div class="card-footer bg-light border-top">
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@post.Id" 
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <form asp-action="DeleteConfirmed" asp-route-id="@post.Id" 
                                          method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this article?');">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <strong>No articles yet.</strong>
            @if (User.IsInRole("Expert") || User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="alert-link">Create the first one</a>
            }
            else
            {
                <span>Check back soon for expert insights!</span>
            }
        </div>
    }
</div>

<!-- Custom CSS for hover effect -->
<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease-in-out;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .card-title a:hover {
        color: #0d6efd !important;
    }
</style>
