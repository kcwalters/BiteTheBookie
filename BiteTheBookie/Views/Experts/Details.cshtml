@model ExpertPost

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <!-- Back Link -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to Articles
        </a>
    </div>

    <!-- Article Card -->
    <div class="card shadow-sm border-0 mb-4">
        <!-- Article Header -->
        <div class="card-header bg-light border-bottom">
            <div class="row align-items-center">
                <div class="col">
                    <h1 class="h2 mb-2">@Model.Title</h1>
                    
                    <!-- Author and Meta Info -->
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        @if (Model.Author != null)
                        {
                            <div>
                                <i class="fas fa-user-circle me-2"></i>
                                <strong>@(Model.Author.FirstName ?? "") @(Model.Author.LastName ?? "")</strong>
                            </div>
                        }
                        
                        <div>
                            <i class="fas fa-calendar me-2"></i>
                            <span>@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>

                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="text-muted">
                                <small>Updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</small>
                            </div>
                        }

                        <div>
                            <i class="fas fa-eye me-2"></i>
                            <span>@Model.ViewCount @(Model.ViewCount == 1 ? "view" : "views")</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Category))
                        {
                            <span class="badge bg-info">
                                <i class="fas fa-tag me-1"></i>@Model.Category
                            </span>
                        }
                    </div>
                </div>

                <!-- Edit/Delete Actions -->
                @if (User.IsInRole("Admin") || 
                     (User.Identity?.IsAuthenticated == true && Model.AuthorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                {
                    <div class="col-auto">
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@Model.Id" 
                               class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" 
                                  method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to delete this article?');">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Article Body -->
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <div class="alert alert-light border-start border-primary border-5 mb-4">
                    <p class="mb-0 lead">@Model.Summary</p>
                </div>
            }

            <div class="article-content">
                @Html.Raw(Model.Content.Replace("\n", "<br />"))
            </div>
        </div>

        <!-- Article Footer -->
        <div class="card-footer bg-light border-top">
            <div class="row">
                <div class="col-md-6">
                    @if (Model.Author != null)
                    {
                        <div class="d-flex align-items-center">
                            <i class="fas fa-user-circle fa-2x me-3 text-secondary"></i>
                            <div>
                                <p class="mb-0">
                                    <strong>About the Author</strong>
                                </p>
                                <p class="text-muted mb-0">
                                    @(Model.Author.FirstName ?? "") @(Model.Author.LastName ?? "")
                                </p>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <p class="text-muted small mb-0">
                        <i class="fas fa-eye me-1"></i>@Model.ViewCount @(Model.ViewCount == 1 ? "person has" : "people have") read this article
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Articles Section (Optional) -->
    <div class="mt-5">
        <h3 class="mb-4">
            <i class="fas fa-bookmark me-2"></i>More Articles
        </h3>
        <div class="alert alert-info">
            <a asp-action="Index" class="alert-link">
                <i class="fas fa-arrow-left me-1"></i>Back to all expert articles
            </a>
        </div>
    </div>
</div>

<!-- Custom CSS for article content -->
<style>
    .article-content {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #333;
    }

    .article-content p {
        margin-bottom: 1rem;
    }

    .article-content strong {
        color: #000;
        font-weight: 600;
    }

    .article-content em {
        font-style: italic;
    }

    .card-header {
        padding: 1.5rem;
    }

    .card-body {
        padding: 2rem;
    }
</style>
