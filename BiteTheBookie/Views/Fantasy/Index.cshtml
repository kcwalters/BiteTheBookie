@model BiteTheBookie.ViewModels.FantasyLobbyViewModel
@{
    ViewData["Title"] = "Daily Fantasy Football";
    var isPaid = ViewBag.IsPaid as bool? ?? false;
    var rosterSlots = BiteTheBookie.Models.Fantasy.FantasyRoster.Slots;
    var rosterSlotCount = rosterSlots.Count;
    var rosterSummary = string.Join(", ", rosterSlots.Select(s => s.Slot));
    var salaryCap = BiteTheBookie.Models.Fantasy.FantasyRoster.DefaultSalaryCap;
}

<div class="container py-4">
    <div class="content-card mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <div class="text-uppercase text-muted small fw-bold">Daily Fantasy</div>
                <h1 class="mb-2">DFS Salary-Cap Contests</h1>
                <p class="text-muted mb-0">Build a lineup under the salary cap using real NFL players. Points are scored from live box-score data.</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> New Contest
                </a>
            }
            @if (isPaid)
            {
                <a asp-action="MyEntries" class="btn btn-outline-primary">
                    <i class="fas fa-list-check me-1"></i> My Entries
                </a>
            }
        </div>
    </div>

    @if (TempData["FantasyMessage"] is string okMsg)
    {
        <div class="alert alert-success">@okMsg</div>
    }
    @if (TempData["FantasyError"] is string errMsg)
    {
        <div class="alert alert-danger">@errMsg</div>
    }

    @if (!isPaid)
    {
        <div class="content-card mb-4 border-warning">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <i class="fas fa-lock fa-2x text-warning"></i>
                <div class="flex-grow-1">
                    <h5 class="mb-1">Building lineups is a members-only feature</h5>
                    <p class="text-muted mb-0">Browse the contests below for a preview. Upgrade to a Pro or All-Access membership to build lineups and enter contests.</p>
                </div>
                <a class="btn btn-primary" asp-controller="Membership" asp-action="Join">
                    <i class="fas fa-crown me-1"></i> Upgrade Your Membership
                </a>
            </div>
        </div>
    }

    <div class="content-card mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#howToPlay" aria-expanded="true" aria-controls="howToPlay">
            <h5 class="mb-0"><i class="fas fa-circle-info me-2 text-primary"></i>How to Play Daily Fantasy</h5>
            <i class="fas fa-chevron-down text-muted"></i>
        </div>
        <div id="howToPlay" class="collapse show mt-3">
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <div class="text-center">
                        <div class="display-6 text-primary"><i class="fas fa-calendar-day"></i></div>
                        <div class="fw-bold">1. Pick a contest</div>
                        <div class="text-muted small">Each contest covers one NFL slate. Enter any contest marked <span class="badge bg-success">Open</span> before it locks.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center">
                        <div class="display-6 text-primary"><i class="fas fa-users"></i></div>
                        <div class="fw-bold">2. Draft a lineup</div>
                        <div class="text-muted small">Fill all @rosterSlotCount roster spots (@rosterSummary) using real NFL players.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center">
                        <div class="display-6 text-primary"><i class="fas fa-coins"></i></div>
                        <div class="fw-bold">3. Stay under the cap</div>
                        <div class="text-muted small">Every player has a salary. Your full lineup must fit under the $@salaryCap.ToString("N0") salary cap.</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="text-center">
                        <div class="display-6 text-primary"><i class="fas fa-trophy"></i></div>
                        <div class="fw-bold">4. Score &amp; climb</div>
                        <div class="text-muted small">After games finish, your players earn PPR fantasy points from real stats. Check the leaderboard to see where you rank.</div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="small text-muted">
                <i class="fas fa-lightbulb me-1 text-warning"></i>
                <strong>Tips:</strong> Edit your lineup as often as you like until the contest locks at the first kickoff.
                Higher-salary players are usually projected to score more&mdash;balance stars with cheaper value picks to fit the cap.
                This is a free-to-play leaderboard for fun&mdash;no real-money wagering.
            </div>
        </div>
    </div>

    @if (!Model.Contests.Any())
    {
        <div class="content-card">
            <p class="mb-0 text-muted">No contests are available yet. Check back soon.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var c in Model.Contests)
            {
                var locked = DateTime.UtcNow >= c.LockTime;
                <div class="col-md-6 col-lg-4">
                    <div class="content-card h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-0">@c.Name</h5>
                            @if (c.IsScored)
                            {
                                <span class="badge bg-secondary">Final</span>
                            }
                            else if (locked)
                            {
                                <span class="badge bg-warning text-dark">Locked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Open</span>
                            }
                        </div>
                        <div class="text-muted small mb-3">
                            <div><i class="fas fa-football-ball me-1"></i> @c.League slate</div>
                            <div><i class="fas fa-coins me-1"></i> Cap: $@c.SalaryCap.ToString("N0")</div>
                            <div><i class="fas fa-lock me-1"></i> Locks: @c.LockTime.ToLocalTime().ToString("ddd MMM d, h:mm tt")</div>
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            @if (c.IsScored)
                            {
                                <a asp-action="Leaderboard" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm">Leaderboard</a>
                            }
                            else
                            {
                                <a asp-action="Contest" asp-route-id="@c.Id" class="btn btn-primary btn-sm">
                                    @(locked ? "View" : "Build Lineup")
                                </a>
                                <a asp-action="Leaderboard" asp-route-id="@c.Id" class="btn btn-outline-secondary btn-sm">Entries</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
