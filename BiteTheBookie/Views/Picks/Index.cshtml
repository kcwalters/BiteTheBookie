@model BiteTheBookie.ViewModels.PicksIndexViewModel
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = $"Scores & Simulations - {Model.LeagueDisplayName}";

    var isPremiumOrVip = false;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        isPremiumOrVip = currentUser?.IsPremium == true;
    }
}

@functions {
    string StatusBadgeClass(BiteTheBookie.Models.NBAGameMatchup g) =>
        g.IsLive ? "bg-danger" : g.IsFinal ? "bg-secondary" : "bg-primary";
}

<div class="container py-4">
    <div class="content-card">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <img src="@Model.LeagueLogo" alt="@Model.LeagueDisplayName" style="width: 44px; height: 44px;" onerror="this.style.display='none'" />
                <div>
                    <h1 class="h3 mb-0">@Model.LeagueDisplayName Scores &amp; Simulations</h1>
                    <div class="text-muted small">@Model.SelectedDateDisplay</div>
                </div>
            </div>

            @* Date navigation (preserves the current league) *@
            <form method="get" asp-action="Schedule" asp-controller="Picks" class="d-flex align-items-center gap-2" id="dateForm">
                <input type="hidden" name="league" value="@Model.League" />
                <a class="btn btn-outline-secondary btn-sm"
                   asp-action="Schedule" asp-controller="Picks" asp-route-league="@Model.League" asp-route-date="@Model.PreviousDateInput"
                   title="Previous day"><i class="fas fa-chevron-left"></i></a>

                <input type="date" name="date" value="@Model.SelectedDateInput"
                       class="form-control form-control-sm" style="max-width: 180px;"
                       onchange="document.getElementById('dateForm').submit()" />

                <a class="btn btn-outline-secondary btn-sm"
                   asp-action="Schedule" asp-controller="Picks" asp-route-league="@Model.League" asp-route-date="@Model.NextDateInput"
                   title="Next day"><i class="fas fa-chevron-right"></i></a>

                @if (!Model.IsToday)
                {
                    <a class="btn btn-outline-primary btn-sm" asp-action="Schedule" asp-controller="Picks" asp-route-league="@Model.League">Today</a>
                }
            </form>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }

        @if (Model.Games == null || !Model.Games.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted mb-0">No @Model.LeagueDisplayName games scheduled for @Model.SelectedDateDisplay.</p>
            </div>
        }
        else
        {
            @* Status filter pills *@
            <ul class="nav nav-pills mb-4" id="statusTabs">
                <li class="nav-item"><a class="nav-link active" href="#" data-status="all">All (@Model.Games.Count())</a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-status="live">Live (@Model.LiveGames.Count())</a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-status="scheduled">Scheduled (@Model.ScheduledGames.Count())</a></li>
                <li class="nav-item"><a class="nav-link" href="#" data-status="final">Final (@Model.FinalGames.Count())</a></li>
            </ul>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Matchup</th>
                            <th>Status</th>
                            <th>Location</th>
                            <th class="text-center">Score</th>
                            <th>Odds</th>
                            <th class="text-end">Simulation</th>
                        </tr>
                    </thead>
                    <tbody id="gamesTableBody">
                        @foreach (var game in Model.Games)
                        {
                            var statusKey = game.IsLive ? "live" : game.IsFinal ? "final" : "scheduled";
                            <tr data-status="@statusKey">
                                <td>
                                    <div class="text-muted small mb-1">@game.GameTimeDisplay</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" style="width: 28px; height: 28px;" onerror="this.style.visibility='hidden'" />
                                        <span class="fw-semibold">@game.AwayTeamName</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" style="width: 28px; height: 28px;" onerror="this.style.visibility='hidden'" />
                                        <span class="fw-semibold">@game.HomeTeamName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @StatusBadgeClass(game)">@game.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(game.StatusDetail))
                                    {
                                        <div class="small text-muted mt-1">@game.StatusDetail</div>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrWhiteSpace(game.Venue) ? "—" : game.Venue)
                                </td>
                                <td class="text-center">
                                    <div>@(game.AwayScore?.ToString() ?? "–")</div>
                                    <div>@(game.HomeScore?.ToString() ?? "–")</div>
                                </td>
                                <td>
                                    @if (game.OverUnder.HasValue)
                                    {
                                        <div><strong>O/U:</strong> @game.OverUnder.Value</div>
                                    }
                                    @if (game.Spread.HasValue)
                                    {
                                        <div><strong>Spread:</strong> @(game.Spread > 0 ? "+" : "")@game.Spread</div>
                                    }
                                    @if (game.HomeMoneyline.HasValue)
                                    {
                                        <div class="small text-muted">ML: @(game.HomeMoneyline > 0 ? "+" : "")@game.HomeMoneyline</div>
                                    }
                                    @if (!game.OverUnder.HasValue && !game.Spread.HasValue && !game.HomeMoneyline.HasValue)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <partial name="Partials/_GameSimulationLink" model='new BiteTheBookie.ViewModels.GameSimulationLinkViewModel { HomeTeam = game.HomeTeamName, AwayTeam = game.AwayTeamName, League = Model.League }' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statusLinks = document.querySelectorAll('#statusTabs .nav-link');
            const rows = document.querySelectorAll('#gamesTableBody tr');
            statusLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    statusLinks.forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.getAttribute('data-status');
                    rows.forEach(row => {
                        row.style.display = (filter === 'all' || row.getAttribute('data-status') === filter) ? '' : 'none';
                    });
                });
            });
        });
    </script>
}
