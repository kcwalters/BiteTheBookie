@model BiteTheBookie.ViewModels.PicksIndexViewModel
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "MLB Expert Picks & Predictions";

    var isPremiumOrVip = false;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        isPremiumOrVip = currentUser?.IsPremium == true;
    }

    var today = DateTime.UtcNow.Date;
    var tomorrow = today.AddDays(1);
    var todayGames = Model.Games.Where(g => g.GameTime.Date == today).ToList();
    var tomorrowGames = Model.Games.Where(g => g.GameTime.Date == tomorrow).ToList();
}

<nav aria-label="breadcrumb" class="container mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="nav-link" asp-controller="Picks" asp-action="Index">Picks</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">MLB</li>
    </ol>
</nav>

<div class="container py-4">
    <div class="content-card mb-4">
        @await Component.InvokeAsync("EspnNewsFeed", new { count = 8, league = "MLB" })
    </div>
    <div class="content-card">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <img src="https://www.mlbstatic.com/team-logos/league-on-dark/1.svg" alt="MLB" style="width: 48px; height: 48px;" />
                <h1 class="h2 mb-0">MLB Games - Today & Tomorrow</h1>
            </div>
            <div class="text-muted">
                <i class="fas fa-calendar me-2"></i>
                Showing all @Model.Games.Count games
            </div>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                @Model.ErrorMessage
            </div>
        }

        @if (!Model.Games.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                No MLB games scheduled for today or tomorrow.
            </div>
        }
        else
        {
            <!-- TODAY'S GAMES -->
            @if (todayGames.Any())
            {
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <h2 class="h4 mb-0 me-3">Today's Games</h2>
                        <span class="badge bg-primary">@todayGames.Count games</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var game in todayGames)
                        {
                            <div class="col-12">
                                <div class="card game-card @(game.Status == "Live" ? "live-game" : "")">
                                    <div class="card-body p-3">
                                        <div class="row align-items-center">
                                            <!-- Game Info Column (Time + Status) -->
                                            <div class="col-auto" style="min-width: 150px;">
                                                <div class="text-muted small mb-2">@game.GameTimeDisplay</div>
                                                <span class="badge @(game.Status == "Live" ? "bg-danger pulse" : game.Status == "Final" ? "bg-secondary" : "bg-primary")">
                                                    @if (game.Status == "Live")
                                                    {
                                                        <i class="fas fa-circle me-1" style="font-size: 8px;"></i>
                                                    }
                                                    @game.Status
                                                </span>
                                            </div>

                                            <!-- Teams & Scores Combined Column -->
                                            <div class="col">
                                                <!-- Away Team Row -->
                                                <div class="d-flex align-items-center mb-2">
                                                    <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" class="team-logo me-2" />
                                                    <div class="flex-grow-1">
                                                        <div class="fw-bold">@game.AwayTeamName</div>
                                                        <div class="text-muted small">Away</div>
                                                    </div>
                                                    <!-- Away Score Box -->
                                                    <div class="score-box @(game.AwayScore > game.HomeScore && game.Status == "Final" ? "winner-box" : "")">
                                                        @if (game.AwayScore.HasValue)
                                                        {
                                                            <span class="score-number">@game.AwayScore</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="score-number text-muted">--</span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Home Team Row -->
                                                <div class="d-flex align-items-center">
                                                    <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" class="team-logo me-2" />
                                                    <div class="flex-grow-1">
                                                        <div class="fw-bold">@game.HomeTeamName</div>
                                                        <div class="text-muted small">Home</div>
                                                    </div>
                                                    <!-- Home Score Box -->
                                                    <div class="score-box @(game.HomeScore > game.AwayScore && game.Status == "Final" ? "winner-box" : "")">
                                                        @if (game.HomeScore.HasValue)
                                                        {
                                                            <span class="score-number">@game.HomeScore</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="score-number text-muted">--</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Betting Lines Column -->
                                            <div class="col-auto">
                                                <div class="d-flex gap-3 betting-lines">
                                                    @if (game.Spread.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">Spread</div>
                                                            <div class="fw-bold">@game.Spread.Value.ToString("+0.0;-0.0")</div>
                                                        </div>
                                                    }
                                                    @if (game.OverUnder.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">O/U</div>
                                                            <div class="fw-bold">@game.OverUnder.Value</div>
                                                        </div>
                                                    }
                                                    @if (game.HomeMoneyline.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">ML</div>
                                                            <div class="fw-bold">@game.HomeMoneyline.Value.ToString("+#;-#")</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Action Button Column -->
                                            <div class="col-auto">
                                                @if (game.Status == "Live")
                                                {
                                                    <button class="btn btn-danger btn-sm" disabled>
                                                        <i class="fas fa-circle pulse me-1" style="font-size: 8px;"></i> Live
                                                    </button>
                                                }
                                                else if (isPremiumOrVip)
                                                {
                                                    <a href="@Url.Action("Detail", "Picks", new { gameId = game.GameId, league = "MLB", homeTeam = game.HomeTeamName, awayTeam = game.AwayTeamName, homeLogo = game.HomeTeamLogo, awayLogo = game.AwayTeamLogo })"
                                                       class="btn btn-sm btn-outline-primary" data-sim-trigger>
                                                        <i class="fas fa-baseball-ball me-1"></i> Game Simulation
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Membership" asp-action="Join"
                                                       class="btn btn-sm btn-warning d-flex flex-column align-items-center gap-1"
                                                       title="Upgrade to view simulation">
                                                        <i class="fas fa-dollar-sign"></i>
                                                        <span class="small fw-semibold">Game Simulation</span>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    No MLB games scheduled for today.
                </div>
            }

            <!-- TOMORROW'S GAMES -->
            @if (tomorrowGames.Any())
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <h2 class="h4 mb-0 me-3">Tomorrow's Games</h2>
                        <span class="badge bg-info">@tomorrowGames.Count games</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var game in tomorrowGames)
                        {
                            <div class="col-12">
                                <div class="card game-card tomorrow-game">
                                    <div class="card-body p-3">
                                        <div class="row align-items-center">
                                            <!-- Game Info Column -->
                                            <div class="col-auto" style="min-width: 150px;">
                                                <div class="text-muted small mb-2">@game.GameTimeDisplay</div>
                                                <span class="badge bg-info">Tomorrow</span>
                                            </div>

                                            <!-- Teams & Scores Combined Column -->
                                            <div class="col">
                                                <!-- Away Team Row -->
                                                <div class="d-flex align-items-center mb-2">
                                                    <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" class="team-logo me-2" />
                                                    <div class="flex-grow-1">
                                                        <div class="fw-bold">@game.AwayTeamName</div>
                                                        <div class="text-muted small">Away</div>
                                                    </div>
                                                    <!-- Away Score Box -->
                                                    <div class="score-box scheduled-box">
                                                        <span class="score-number text-muted">--</span>
                                                    </div>
                                                </div>

                                                <!-- Home Team Row -->
                                                <div class="d-flex align-items-center">
                                                    <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" class="team-logo me-2" />
                                                    <div class="flex-grow-1">
                                                        <div class="fw-bold">@game.HomeTeamName</div>
                                                        <div class="text-muted small">Home</div>
                                                    </div>
                                                    <!-- Home Score Box -->
                                                    <div class="score-box scheduled-box">
                                                        <span class="score-number text-muted">--</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Betting Lines Column -->
                                            <div class="col-auto">
                                                <div class="d-flex gap-3 betting-lines">
                                                    @if (game.Spread.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">Spread</div>
                                                            <div class="fw-bold">@game.Spread.Value.ToString("+0.0;-0.0")</div>
                                                        </div>
                                                    }
                                                    @if (game.OverUnder.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">O/U</div>
                                                            <div class="fw-bold">@game.OverUnder.Value</div>
                                                        </div>
                                                    }
                                                    @if (game.HomeMoneyline.HasValue)
                                                    {
                                                        <div class="text-center">
                                                            <div class="small text-muted">ML</div>
                                                            <div class="fw-bold">@game.HomeMoneyline.Value.ToString("+#;-#")</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Action Button Column -->
                                            <div class="col-auto">
                                                @if (isPremiumOrVip)
                                                {
                                                    <a href="@Url.Action("Detail", "Picks", new { gameId = game.GameId, league = "MLB", homeTeam = game.HomeTeamName, awayTeam = game.AwayTeamName, homeLogo = game.HomeTeamLogo, awayLogo = game.AwayTeamLogo })"
                                                       class="btn btn-outline-primary btn-sm" data-sim-trigger>
                                                        <i class="fas fa-baseball-ball me-1"></i> Game Simulation
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Membership" asp-action="Join"
                                                       class="btn btn-sm btn-warning d-flex flex-column align-items-center gap-1"
                                                       title="Upgrade to view simulation">
                                                        <i class="fas fa-dollar-sign"></i>
                                                        <span class="small fw-semibold">Game Simulation</span>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No MLB games scheduled for tomorrow.
                </div>
            }
        }
    </div>
</div>

<style>
    .game-card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }
    
    .game-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }
    
    .game-card.live-game {
        border-color: #dc3545;
        box-shadow: 0 0 20px rgba(220, 53, 69, 0.3);
    }
    
    .game-card.tomorrow-game {
        opacity: 0.95;
    }
    
    .team-logo {
        width: 40px;
        height: 40px;
        object-fit: contain;
    }
    
    /* Blue Score Boxes - Right-aligned */
    .score-box {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        border-radius: 8px;
        padding: 8px 16px;
        text-align: center;
        width: 70px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(13, 110, 253, 0.3);
        transition: all 0.2s ease;
        flex-shrink: 0;
        margin-left: 12px;
    }
    
    .score-box:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
    }
    
    .score-box.winner-box {
        background: linear-gradient(135deg, #198754 0%, #146c43 100%);
        box-shadow: 0 2px 8px rgba(25, 135, 84, 0.3);
        animation: winner-pulse 2s infinite;
    }
    
    .score-box.scheduled-box {
        background: linear-gradient(135deg, #6c757d 0%, #5c636a 100%);
        box-shadow: 0 2px 8px rgba(108, 117, 125, 0.2);
    }
    
    .score-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        line-height: 1;
    }
    
    @@keyframes winner-pulse {
        0%, 100% {
            box-shadow: 0 2px 8px rgba(25, 135, 84, 0.3);
        }
        50% {
            box-shadow: 0 4px 16px rgba(25, 135, 84, 0.6);
        }
    }
    
    .betting-lines {
        min-width: 200px;
    }
    
    .pulse {
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }
    
    .badge.pulse {
        animation: pulse-badge 1.5s infinite;
    }
    
    @@keyframes pulse-badge {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }
        50% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }
    }
    
    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .row.align-items-center {
            flex-direction: column;
            align-items: stretch !important;
        }
        
        .col-auto {
            width: 100%;
            max-width: 100%;
            margin-bottom: 1rem;
        }
        
        .score-box {
            width: 100%;
            margin-bottom: 0.5rem;
            margin-left: 0;
        }
        
        .betting-lines {
            justify-content: space-between;
            width: 100%;
        }
    }
</style>

@section Scripts {
    <script>
        (function() {
            const hasLiveGames = document.querySelector('.badge.bg-danger.pulse');
            if (hasLiveGames) {
                console.log('Live games detected - page will refresh in 30 seconds');
                setTimeout(function() {
                    location.reload();
                }, 30000);
            }
        })();
    </script>
}