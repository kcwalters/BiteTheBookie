@model BiteTheBookie.ViewModels.AgainstTheSpreadViewModel

@{
    ViewData["Title"] = "Against the Spread - Contrarian Betting Opportunities";
}

<div class="container">
    <div class="tickers-row">
        <div id="nfl-ticker" style="display: none;">
            @await Component.InvokeAsync("NFLTicker")
        </div>
        <div id="nba-ticker">
            @await Component.InvokeAsync("NBATicker")
        </div>
        <div id="nhl-ticker" style="display: none;">
            @await Component.InvokeAsync("NHLTicker")
        </div>
        <div id="ncaa-ticker" style="display: none;">
            @await Component.InvokeAsync("NCAATicker")
        </div>
        <div id="mlb-ticker" style="display: none;">
            @await Component.InvokeAsync("MLBTicker")
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("Index", "Picks")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to All Picks
        </a>
    </div>

    <div class="content-card">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <img src="https://sports.cbsimg.net/fly/images/league-logos/54.svg" alt="NBA" style="width: 48px; height: 48px;" />
                <div>
                    <h1 class="h2 mb-0">Against the Spread</h1>
                    <p class="text-muted small mb-0">Contrarian Betting Opportunities</p>
                </div>
            </div>
        </div>

        <!-- Info Banner -->
        <div class="alert alert-info mb-4">
            <h5 class="alert-heading"><i class="bi bi-info-circle"></i> What is "Against the Spread"?</h5>
            <p class="mb-0">These are contrarian betting opportunities where our analysis suggests going against the popular opinion. We identify games where the spread may be overvalued or undervalued, offering potential value for smart bettors.</p>
        </div>

        @if (Model.Opportunities != null && Model.Opportunities.Any())
        {
            <div class="row g-4">
                @foreach (var opportunity in Model.Opportunities)
                {
                    <div class="col-12">
                        <div class="card h-100 shadow-sm border-0 opportunity-card">
                            <div class="card-header bg-gradient-primary text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">@opportunity.Game.AwayTeamName @@ @opportunity.Game.HomeTeamName</h5>
                                        <small>@opportunity.Game.GameTimeDisplay</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-light text-dark fs-6">
                                            @opportunity.ValueRating
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- Game Info -->
                                    <div class="col-md-3">
                                        <div class="text-center mb-3">
                                            <div class="d-flex flex-column gap-2">
                                                <div class="team-display">
                                                    <img src="@opportunity.Game.AwayTeamLogo" alt="@opportunity.Game.AwayTeamName" style="width: 40px; height: 40px;" />
                                                    <span class="ms-2 fw-semibold">@opportunity.Game.AwayTeamName</span>
                                                </div>
                                                <div class="text-muted">vs</div>
                                                <div class="team-display">
                                                    <img src="@opportunity.Game.HomeTeamLogo" alt="@opportunity.Game.HomeTeamName" style="width: 40px; height: 40px;" />
                                                    <span class="ms-2 fw-semibold">@opportunity.Game.HomeTeamName</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-center">
                                            <div class="mb-2">
                                                <strong>Spread:</strong> @(opportunity.Game.Spread > 0 ? "+" : "")@opportunity.Game.Spread
                                            </div>
                                            @if (opportunity.Game.OverUnder.HasValue)
                                            {
                                                <div>
                                                    <strong>O/U:</strong> @opportunity.Game.OverUnder
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Recommendation -->
                                    <div class="col-md-9">
                                        <div class="recommendation-box p-3 mb-3 bg-success-subtle rounded">
                                            <h4 class="text-success mb-2">
                                                <i class="bi bi-check-circle"></i> Recommended Bet: @opportunity.RecommendedBet
                                            </h4>
                                            <div class="confidence-bar mb-2">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <strong>Confidence:</strong>
                                                    <span class="badge bg-success">@opportunity.Confidence%</span>
                                                </div>
                                                <div class="progress" style="height: 25px;">
                                                    <div class="progress-bar bg-success" 
                                                         role="progressbar" 
                                                         style="width: @opportunity.Confidence%"
                                                         aria-valuenow="@opportunity.Confidence" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @opportunity.Confidence%
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="reasoning mb-3">
                                            <h6 class="fw-bold">Why This Bet?</h6>
                                            <p class="mb-0">@opportunity.Reasoning</p>
                                        </div>

                                        <div class="statistical-edges">
                                            <h6 class="fw-bold">Statistical Advantages:</h6>
                                            <ul class="list-unstyled">
                                                @foreach (var edge in opportunity.StatisticalEdges)
                                                {
                                                    <li class="mb-1">
                                                        <i class="bi bi-arrow-right-circle text-primary"></i> @edge
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                        <div class="mt-3">
                                            <a href="@Url.Action("Detail", "Picks", new { gameId = opportunity.Game.GameId })" 
                                               class="btn btn-primary">
                                                <i class="bi bi-graph-up"></i> View Full Simulation
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <h5 class="alert-heading">No Opportunities Found</h5>
                <p class="mb-0">No strong contrarian betting opportunities identified at this time. Check back later for updated analysis.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/tickers.js" asp-append-version="true"></script>
}

<style>
    .content-card {
        background-color: #ffffff;
        color: #212529;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border-radius: 8px;
        padding: 2rem;
    }

    .opportunity-card {
        border-left: 5px solid #0066cc;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .opportunity-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
    }

    .team-display {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .recommendation-box {
        border-left: 4px solid #28a745;
    }

    .bg-success-subtle {
        background-color: #d4edda;
    }

    .progress {
        background-color: #e9ecef;
    }

    .progress-bar {
        font-weight: 600;
        font-size: 14px;
    }

    .statistical-edges ul li {
        padding: 0.5rem 0;
        border-bottom: 1px solid #e9ecef;
    }

    .statistical-edges ul li:last-child {
        border-bottom: none;
    }

    .btn-primary {
        background-color: #0066cc;
        border-color: #0066cc;
        font-weight: 600;
    }

    .btn-primary:hover {
        background-color: #0052a3;
        border-color: #0052a3;
    }

    .btn-outline-secondary {
        color: #6c757d;
        border-color: #6c757d;
        font-weight: 500;
    }

    .btn-outline-secondary:hover {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #ffffff;
    }

    .alert-info {
        background-color: #d1ecf1;
        border-color: #17a2b8;
        color: #0c5460;
        border-width: 2px;
    }

    .alert-warning {
        background-color: #fff3cd;
        border-color: #ffc107;
        color: #856404;
        border-width: 2px;
    }

    h1, h2, h3, h4, h5, h6 {
        color: #212529;
    }

    .text-success {
        color: #28a745 !important;
    }

    .fw-semibold {
        font-weight: 600;
    }
</style>
