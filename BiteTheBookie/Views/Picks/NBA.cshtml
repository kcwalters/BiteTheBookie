@model BiteTheBookie.ViewModels.PicksIndexViewModel

@{
    ViewData["Title"] = "NBA Expert Picks & Predictions";
    
    // Group games by date
    var today = DateTime.UtcNow.Date;
    var tomorrow = today.AddDays(1);
    var todayGames = Model.Games.Where(g => g.GameTime.Date == today).ToList();
    var tomorrowGames = Model.Games.Where(g => g.GameTime.Date == tomorrow).ToList();
}

<div class="container">
    <div class="tickers-row">
        <div id="nfl-ticker" style="display: none;">
            @await Component.InvokeAsync("NFLTicker")
        </div>
        <div id="nba-ticker">
            @await Component.InvokeAsync("NBATicker")
        </div>
        <div id="nhl-ticker" style="display: none;">
            @await Component.InvokeAsync("NHLTicker")
        </div>
        <div id="ncaa-ticker" style="display: none;">
            @await Component.InvokeAsync("NCAATicker")
        </div>
        <div id="mlb-ticker" style="display: none;">
            @await Component.InvokeAsync("MLBTicker")
        </div>
    </div>
</div>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a class="nav-link" asp-controller="Picks" asp-action="Index">Picks</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">NBA</li>
    </ol>
</nav>

<div class="container py-4">
    <div class="content-card">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <img src="https://sports.cbsimg.net/fly/images/league-logos/54.svg" alt="NBA" style="width: 48px; height: 48px;" />
                <h1 class="h2 mb-0">NBA Games - Today & Tomorrow</h1>
            </div>
            <div class="text-muted">
                <i class="fas fa-calendar me-2"></i>
                Showing all @Model.Games.Count games
            </div>
        </div>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                @Model.ErrorMessage
            </div>
        }

        @if (!Model.Games.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                No NBA games scheduled for today or tomorrow.
            </div>
        }
        else
        {
            <!-- TODAY'S GAMES -->
            @if (todayGames.Any())
            {
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <h2 class="h4 mb-0 me-3">Today's Games</h2>
                        <span class="badge bg-primary">@todayGames.Count games</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var game in todayGames)
                        {
                            <div class="col-12 col-lg-6 col-xl-4">
                                <div class="card h-100 game-card @(game.Status == "Live" ? "live-game" : "")">
                                    <div class="card-body">
                                        <!-- Game Header -->
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="text-muted small">@game.GameTimeDisplay</span>
                                            <span class="badge @(game.Status == "Live" ? "bg-danger pulse" : game.Status == "Final" ? "bg-secondary" : "bg-primary")">
                                                @if (game.Status == "Live")
                                                {
                                                    <i class="fas fa-circle me-1" style="font-size: 8px;"></i>
                                                }
                                                @game.Status
                                            </span>
                                        </div>

                                        <!-- Away Team -->
                                        <div class="d-flex justify-content-between align-items-center mb-2 team-row">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" class="team-logo" />
                                                <div>
                                                    <div class="fw-bold team-name">@game.AwayTeamName</div>
                                                    <div class="text-muted small">Away</div>
                                                </div>
                                            </div>
                                            <div class="score @(game.AwayScore > game.HomeScore && game.Status == "Final" ? "winner" : "")">
                                                @if (game.AwayScore.HasValue)
                                                {
                                                    <span class="h3 mb-0 fw-bold">@game.AwayScore</span>
                                                }
                                                else
                                                {
                                                    <span class="h4 mb-0 text-muted">--</span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Home Team -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 team-row">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" class="team-logo" />
                                                <div>
                                                    <div class="fw-bold team-name">@game.HomeTeamName</div>
                                                    <div class="text-muted small">Home</div>
                                                </div>
                                            </div>
                                            <div class="score @(game.HomeScore > game.AwayScore && game.Status == "Final" ? "winner" : "")">
                                                @if (game.HomeScore.HasValue)
                                                {
                                                    <span class="h3 mb-0 fw-bold">@game.HomeScore</span>
                                                }
                                                else
                                                {
                                                    <span class="h4 mb-0 text-muted">--</span>
                                                }
                                            </div>
                                        </div>

                                        <hr />

                                        <!-- Betting Lines -->
                                        <div class="row text-center g-2 mb-3">
                                            @if (game.Spread.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">Spread</div>
                                                    <div class="fw-bold">@game.Spread.Value.ToString("+0.0;-0.0")</div>
                                                </div>
                                            }
                                            @if (game.OverUnder.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">O/U</div>
                                                    <div class="fw-bold">@game.OverUnder.Value</div>
                                                </div>
                                            }
                                            @if (game.HomeMoneyline.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">ML</div>
                                                    <div class="fw-bold">@game.HomeMoneyline.Value.ToString("+#;-#")</div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Action Button -->
                                        @if (game.Status == "Scheduled")
                                        {
                                            <a asp-controller="Picks" asp-action="Detail" asp-route-gameId="@game.GameId" 
                                               class="btn btn-primary w-100 btn-sm">
                                                <i class="fas fa-chart-line me-2"></i> View Analysis
                                            </a>
                                        }
                                        else if (game.Status == "Live")
                                        {
                                            <button class="btn btn-danger w-100 btn-sm" disabled>
                                                <i class="fas fa-circle pulse me-2" style="font-size: 8px;"></i> In Progress
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary w-100 btn-sm" disabled>
                                                <i class="fas fa-check me-2"></i> Final
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    No NBA games scheduled for today.
                </div>
            }

            <!-- TOMORROW'S GAMES -->
            @if (tomorrowGames.Any())
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <h2 class="h4 mb-0 me-3">Tomorrow's Games</h2>
                        <span class="badge bg-info">@tomorrowGames.Count games</span>
                    </div>
                    
                    <div class="row g-4">
                        @foreach (var game in tomorrowGames)
                        {
                            <div class="col-12 col-lg-6 col-xl-4">
                                <div class="card h-100 game-card tomorrow-game">
                                    <div class="card-body">
                                        <!-- Game Header -->
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="text-muted small">@game.GameTimeDisplay</span>
                                            <span class="badge bg-info">Tomorrow</span>
                                        </div>

                                        <!-- Away Team -->
                                        <div class="d-flex justify-content-between align-items-center mb-2 team-row">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" class="team-logo" />
                                                <div>
                                                    <div class="fw-bold team-name">@game.AwayTeamName</div>
                                                    <div class="text-muted small">Away</div>
                                                </div>
                                            </div>
                                            <span class="h4 mb-0 text-muted">--</span>
                                        </div>

                                        <!-- Home Team -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 team-row">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1">
                                                <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" class="team-logo" />
                                                <div>
                                                    <div class="fw-bold team-name">@game.HomeTeamName</div>
                                                    <div class="text-muted small">Home</div>
                                                </div>
                                            </div>
                                            <span class="h4 mb-0 text-muted">--</span>
                                        </div>

                                        <hr />

                                        <!-- Betting Lines -->
                                        <div class="row text-center g-2 mb-3">
                                            @if (game.Spread.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">Spread</div>
                                                    <div class="fw-bold">@game.Spread.Value.ToString("+0.0;-0.0")</div>
                                                </div>
                                            }
                                            @if (game.OverUnder.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">O/U</div>
                                                    <div class="fw-bold">@game.OverUnder.Value</div>
                                                </div>
                                            }
                                            @if (game.HomeMoneyline.HasValue)
                                            {
                                                <div class="col-4">
                                                    <div class="small text-muted">ML</div>
                                                    <div class="fw-bold">@game.HomeMoneyline.Value.ToString("+#;-#")</div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Action Button -->
                                        <a asp-controller="Picks" asp-action="Detail" asp-route-gameId="@game.GameId" 
                                           class="btn btn-outline-primary w-100 btn-sm">
                                            <i class="fas fa-chart-line me-2"></i> View Analysis
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    No NBA games scheduled for tomorrow.
                </div>
            }
        }
    </div>
</div>

<style>
    .game-card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }
    
    .game-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    
    .game-card.live-game {
        border-color: #dc3545;
        box-shadow: 0 0 20px rgba(220, 53, 69, 0.3);
    }
    
    .game-card.tomorrow-game {
        opacity: 0.95;
    }
    
    .team-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
    }
    
    .team-name {
        font-size: 1rem;
    }
    
    .score {
        min-width: 50px;
        text-align: right;
    }
    
    .score.winner {
        color: #198754;
        font-weight: 700;
    }
    
    .team-row {
        padding: 8px;
        border-radius: 8px;
        transition: background-color 0.2s;
    }
    
    .team-row:hover {
        background-color: #f8f9fa;
    }
    
    .pulse {
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    
    .badge.pulse {
        animation: pulse-badge 1.5s infinite;
    }
    
    @@keyframes pulse-badge {
        0%, 100% { 
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }
        50% { 
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }
    }
</style>

@section Scripts {
    <script src="~/js/tickers.js" asp-append-version="true"></script>
    <script>
        // Auto-refresh page every 30 seconds if there are live games
        (function() {
            const hasLiveGames = document.querySelector('.badge.bg-danger.pulse');
            if (hasLiveGames) {
                console.log('Live games detected - page will refresh in 30 seconds');
                setTimeout(function() {
                    location.reload();
                }, 30000);
            }
        })();
    </script>
}
