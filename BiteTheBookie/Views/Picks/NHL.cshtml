@model BiteTheBookie.ViewModels.NHLLandingViewModel
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "NHL - Headlines & Picks";

    var isPremiumOrVip = false;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        isPremiumOrVip = currentUser?.IsPremium == true;
    }
}

<div class="container py-4">
    <div class="content-card">
        <div class="d-flex align-items-center gap-3 mb-3">
            <h1 class="h2 mb-0">NHL</h1>
        </div>
        <p class="text-muted mb-0">NHL scores, simulations, and picks are coming soon.</p>
    </div>

    <div class="content-card mt-4">
        @await Component.InvokeAsync("EspnNewsFeed", new { count = 8, league = "NHL" })
    </div>

    <div class="game-card__actions">
        @if (isPremiumOrVip)
        {
            <a asp-controller="Picks" asp-action="ViewPick" asp-route-league="NHL"
               class="btn btn-sm btn-outline-primary">
                View Premium Picks
            </a>
        }
        else
        {
            <a asp-controller="Membership" asp-action="Join" class="btn btn-sm btn-warning">
                Upgrade to View Picks
            </a>
        }
    </div>
</div>
