@model BiteTheBookie.ViewModels.GameSimulationViewModel

@{
    ViewData["Title"] = $"Game Simulation - {Model.AwayTeam} vs {Model.HomeTeam}";
}

<div class="container">
    <div class="tickers-row">
        <div id="nfl-ticker" style="display: none;">
            @await Component.InvokeAsync("NFLTicker")
        </div>
        <div id="nba-ticker">
            @await Component.InvokeAsync("NBATicker")
        </div>
        <div id="nhl-ticker" style="display: none;">
            @await Component.InvokeAsync("NHLTicker")
        </div>
        <div id="ncaa-ticker" style="display: none;">
            @await Component.InvokeAsync("NCAATicker")
        </div>
        <div id="mlb-ticker" style="display: none;">
            @await Component.InvokeAsync("MLBTicker")
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("Index", "Picks")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Picks
        </a>
    </div>

    <!-- Game Header -->
    <div class="content-card mb-4">
        <div class="text-center py-4">
            <div class="d-flex justify-content-center align-items-center gap-4 mb-3">
                <div class="text-center">
                    <img src="@Model.AwayTeamLogo" alt="@Model.AwayTeam" style="width: 80px; height: 80px;" />
                    <h3 class="mt-2 mb-0">@Model.AwayTeam</h3>
                </div>
                <div class="text-center">
                    <div class="h1 text-primary mb-0">VS</div>
                    <div class="text-muted small">@Model.League</div>
                </div>
                <div class="text-center">
                    <img src="@Model.HomeTeamLogo" alt="@Model.HomeTeam" style="width: 80px; height: 80px;" />
                    <h3 class="mt-2 mb-0">@Model.HomeTeam</h3>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error Generating Simulation</h4>
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <!-- AI Generated Simulation Content -->
    <div class="content-card">
        @if (Model.IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Generating simulation with AI...</p>
            </div>
        }
        else
        {
            <div class="simulation-content">
                @if (!string.IsNullOrEmpty(Model.SimulationContent))
                {
                    <!-- Render AI-generated content as Markdown -->
                    <div class="markdown-content">
                        @Html.Raw(Markdig.Markdown.ToHtml(Model.SimulationContent))
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <p class="mb-0">No simulation content available. Please try again.</p>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Action Buttons -->
    <div class="content-card mt-4">
        <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-primary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Regenerate Simulation
            </button>
            <a href="@Url.Action("Index", "Picks")" class="btn btn-outline-secondary">
                View All Picks
            </a>
        </div>
    </div>
</div>

<style>
    .simulation-content {
        line-height: 1.8;
    }

    .markdown-content h1 {
        font-size: 2rem;
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: #0d6efd;
    }

    .markdown-content h2 {
        font-size: 1.5rem;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        border-bottom: 2px solid #dee2e6;
        padding-bottom: 0.5rem;
    }

    .markdown-content h3 {
        font-size: 1.25rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }

    .markdown-content ul, .markdown-content ol {
        margin-left: 1.5rem;
        margin-bottom: 1rem;
    }

    .markdown-content li {
        margin-bottom: 0.5rem;
    }

    .markdown-content strong {
        color: #0d6efd;
        font-weight: 600;
    }

    .markdown-content p {
        margin-bottom: 1rem;
    }

    .markdown-content table {
        width: 100%;
        margin: 1rem 0;
        border-collapse: collapse;
    }

    .markdown-content table th,
    .markdown-content table td {
        padding: 0.75rem;
        border: 1px solid #dee2e6;
    }

    .markdown-content table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }
</style>

@section Scripts {
    <script src="~/js/tickers.js" asp-append-version="true"></script>
}
