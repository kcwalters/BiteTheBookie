@{
    ViewData["Title"] = "Game Simulation - Celtics vs Bucks";
}

<div class="container">
    <div class="tickers-row">
        <div id="nfl-ticker" style="display: none;">
            @await Component.InvokeAsync("NFLTicker")
        </div>
        <div id="nba-ticker">
            @await Component.InvokeAsync("NBATicker")
        </div>
        <div id="nhl-ticker" style="display: none;">
            @await Component.InvokeAsync("NHLTicker")
        </div>
        <div id="ncaa-ticker" style="display: none;">
            @await Component.InvokeAsync("NCAATicker")
        </div>
        <div id="mlb-ticker" style="display: none;">
            @await Component.InvokeAsync("MLBTicker")
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Back Button -->
    <div class="mb-3">
        <a href="@Url.Action("Index", "Picks")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Picks
        </a>
    </div>

    <!-- Game Header -->
    <div class="content-card mb-4">
        <div class="text-center py-4">
            <div class="d-flex justify-content-center align-items-center gap-4 mb-3">
                <div class="text-center">
                    <img src="https://sports.cbsimg.net/fly/images/nba/logos/team/334.svg" alt="Boston" style="width: 80px; height: 80px;" />
                    <h3 class="mt-2 mb-0">Boston Celtics</h3>
                </div>
                <div class="text-center">
                    <div class="h1 text-primary mb-0">114 - 109</div>
                    <div class="text-muted small">Simulated Final</div>
                </div>
                <div class="text-center">
                    <img src="https://sports.cbsimg.net/fly/images/nba/logos/team/347.svg" alt="Milwaukee" style="width: 80px; height: 80px;" />
                    <h3 class="mt-2 mb-0">Milwaukee Bucks</h3>
                </div>
            </div>
            <p class="text-muted mb-0">March 3, 2026</p>
        </div>
    </div>

    <!-- Game Summary -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span style="font-size: 1.5rem;">??</span>
            <h2 class="h4 mb-0">Simulated Game Summary</h2>
        </div>
        <p class="lead">Boston edges Milwaukee in a tight, playoff-style battle on March 3, 2026, with a simulated final score of 114–109, driven by late-game execution and a standout two-way performance from Jayson Tatum.</p>
        <p class="mb-0">Boston's depth and perimeter defense swing the matchup, while Milwaukee leans heavily on Giannis to keep it close.</p>
    </div>

    <!-- Key Performers -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span style="font-size: 1.5rem;">?</span>
            <h2 class="h4 mb-0">Key Performers</h2>
        </div>

        <div class="row g-3">
            <!-- Boston Players -->
            <div class="col-12 col-lg-6">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Boston Celtics</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3 pb-3 border-bottom">
                            <h6 class="fw-bold">Jayson Tatum</h6>
                            <div class="d-flex gap-3 mb-2">
                                <span class="badge bg-success">33 pts</span>
                                <span class="badge bg-info">9 reb</span>
                                <span class="badge bg-warning text-dark">5 ast</span>
                                <span class="badge bg-secondary">2 stl</span>
                            </div>
                            <p class="small mb-0 text-muted">Efficient scoring and clutch shot-making in the final two minutes.</p>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <h6 class="fw-bold">Jaylen Brown</h6>
                            <div class="d-flex gap-3 mb-2">
                                <span class="badge bg-success">26 pts</span>
                                <span class="badge bg-info">6 reb</span>
                            </div>
                            <p class="small mb-0 text-muted">Attacked mismatches and hit two big third-quarter threes.</p>
                        </div>
                        <div>
                            <h6 class="fw-bold">Kristaps Porzi??is</h6>
                            <div class="d-flex gap-3 mb-2">
                                <span class="badge bg-success">18 pts</span>
                                <span class="badge bg-danger">3 blk</span>
                            </div>
                            <p class="small mb-0 text-muted">Rim protection changed Milwaukee's drives late.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Milwaukee Players -->
            <div class="col-12 col-lg-6">
                <div class="card h-100 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Milwaukee Bucks</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3 pb-3 border-bottom">
                            <h6 class="fw-bold">Giannis Antetokounmpo</h6>
                            <div class="d-flex gap-3 mb-2">
                                <span class="badge bg-success">37 pts</span>
                                <span class="badge bg-info">12 reb</span>
                                <span class="badge bg-warning text-dark">7 ast</span>
                            </div>
                            <p class="small mb-0 text-muted">Dominant but forced into tough shots in crunch time.</p>
                        </div>
                        <div>
                            <h6 class="fw-bold">Damian Lillard</h6>
                            <div class="d-flex gap-3 mb-2">
                                <span class="badge bg-success">24 pts</span>
                                <span class="badge bg-warning text-dark">8 ast</span>
                            </div>
                            <p class="small mb-0 text-muted">Hot early, cooled late under Boston's switching defense.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- How the Game Played Out -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span style="font-size: 1.5rem;">??</span>
            <h2 class="h4 mb-0">How the Game Played Out</h2>
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">First Half</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-3">
                            <li class="mb-2">? Milwaukee opens strong behind Giannis attacking early mismatches.</li>
                            <li class="mb-2">? Boston counters with balanced scoring; Tatum finds rhythm from mid-range.</li>
                        </ul>
                        <div class="text-center p-3 bg-light rounded">
                            <strong>Halftime: MIL 58 – BOS 56</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Third Quarter</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-3">
                            <li class="mb-2">? Boston's defense tightens, forcing turnovers that lead to transition buckets.</li>
                            <li class="mb-2">? Brown sparks a 10–2 run with back-to-back threes.</li>
                        </ul>
                        <div class="text-center p-3 bg-light rounded">
                            <strong>End of 3rd: BOS 87 – MIL 82</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Fourth Quarter - Crunch Time</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">?? Giannis powers a Milwaukee comeback, tying the game at 102 with 3:11 left.</li>
                            <li class="mb-2">?? Tatum responds with a step-back three and a tough drive.</li>
                            <li class="mb-2">?? Porzi??is blocks Lillard at the rim with 40 seconds left, sealing momentum.</li>
                            <li class="mb-2">?? Boston hits free throws to close it out.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Stats -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center gap-2 mb-4">
            <span style="font-size: 1.5rem;">??</span>
            <h2 class="h4 mb-0">Team Stats (Simulated)</h2>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th class="text-center">Celtics</th>
                        <th class="text-center">Bucks</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-semibold">Field Goal %</td>
                        <td class="text-center"><span class="badge bg-success">49%</span></td>
                        <td class="text-center"><span class="badge bg-secondary">46%</span></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">3-Point Makes</td>
                        <td class="text-center"><span class="badge bg-success">15/38</span></td>
                        <td class="text-center"><span class="badge bg-secondary">12/35</span></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Rebounds</td>
                        <td class="text-center"><span class="badge bg-success">44</span></td>
                        <td class="text-center"><span class="badge bg-secondary">41</span></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Turnovers</td>
                        <td class="text-center"><span class="badge bg-success">11</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">14</span></td>
                    </tr>
                    <tr>
                        <td class="fw-semibold">Fast-break Points</td>
                        <td class="text-center"><span class="badge bg-success">18</span></td>
                        <td class="text-center"><span class="badge bg-secondary">10</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="alert alert-info mb-0" role="alert">
            <strong>Key Takeaway:</strong> Boston wins by controlling the perimeter and getting timely stops.
        </div>
    </div>

    <!-- Betting Insights -->
    <div class="content-card">
        <h3 class="h4 mb-3">Betting Insights</h3>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Spread</h5>
                        <p class="h3 text-success mb-2">BOS -2.5 ?</p>
                        <p class="small text-muted mb-0">Boston covers by 2.5 points</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Over/Under</h5>
                        <p class="h3 text-success mb-2">Over 215.5 ?</p>
                        <p class="small text-muted mb-0">Total: 223 (7.5 over)</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Moneyline</h5>
                        <p class="h3 text-success mb-2">BOS Wins ?</p>
                        <p class="small text-muted mb-0">Boston prevails 114-109</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tickers.js" asp-append-version="true"></script>
}
