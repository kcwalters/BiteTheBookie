@model BiteTheBookie.ViewModels.GameSimulationViewModel
@using Microsoft.AspNetCore.Identity
@using BiteTheBookie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = $"{Model.AwayTeam} vs {Model.HomeTeam} - Game Simulation";
}

<div class="container py-4">

    <!-- Header -->
    <div class="content-card mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <h1 class="h4 mb-0 fw-bold d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center gap-2">
                        <img src="@Model.AwayTeamLogo" alt="@Model.AwayTeam" style="width:40px;height:40px;object-fit:contain;" />
                        @Model.AwayTeam
                    </span>
                    <span class="text-muted">@@</span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <img src="@Model.HomeTeamLogo" alt="@Model.HomeTeam" style="width:40px;height:40px;object-fit:contain;" />
                        @Model.HomeTeam
                    </span>
                </h1>
                <span class="badge bg-primary">@Model.League · AI Game Simulation</span>
            </div>
            <a asp-controller="Picks" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Back to Picks
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <!-- Error state -->
        <div class="content-card">
            <div class="alert alert-danger mb-0">
                <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Error Generating Simulation</h5>
                <p class="mb-0">@Model.ErrorMessage</p>
            </div>
        </div>
    }
    else
    {
        <!-- Cache notice -->
        @if (Model.IsFromCache && Model.CachedAt.HasValue)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                <i class="fas fa-database fs-5"></i>
                <span>
                    Simulation loaded from today&rsquo;s saved results
                    <span class="text-muted ms-1">(generated @Model.CachedAt.Value.ToLocalTime().ToString("h:mm tt"))</span>
                    &mdash;
                    <a href="@Url.Action("Detail", "Picks", new { gameId = Model.GameId, regenerate = true })"
                       class="alert-link" data-sim-trigger>regenerate a fresh simulation</a>.
                </span>
            </div>
        }

        <!-- Simulation content -->
        <div class="content-card">
            @if (string.IsNullOrWhiteSpace(Model.SimulationContent))
            {
                <div class="alert alert-warning mb-0">
                    <p class="mb-0">No simulation content is available. Please try regenerating.</p>
                </div>
            }
            else
            {
                <div class="simulation-content markdown-content">
                    @Html.Raw(Model.SimulationContent)
                </div>
            }
        </div>

        <!-- Action buttons -->
        <div class="content-card mt-4">
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a href="@Url.Action("Detail", "Picks", new { gameId = Model.GameId, regenerate = true })"
                   class="btn btn-primary" data-sim-trigger>
                    <i class="fas fa-sync-alt me-1"></i> Regenerate Simulation
                </a>
                <a asp-controller="Picks" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-list me-1"></i> View All Picks
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/tickers.js" asp-append-version="true"></script>
}
