@model BiteTheBookie.ViewModels.NFLLandingViewModel
@using BiteTheBookie.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "NFL - Scores, Schedule & Headlines";
    var featured = Model.FeaturedHeadline;
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var hasGameSimulationAccess = currentUser?.IsProUser == true || currentUser?.AllAccessUser == true;
}

<div class="container nfl-landing py-3">

    <!-- Section header -->
    <div class="nfl-landing__header">
        <div class="d-flex align-items-center gap-2">
            <img src="@Model.LeagueLogo" alt="NFL" class="nfl-landing__logo" />
            <span class="nfl-landing__title">NFL</span>
        </div>
        <ul class="nfl-landing__subnav">
            <li><a class="active" asp-controller="NFL" asp-action="Index">Home</a></li>
            <li><a asp-controller="NFL" asp-action="AllTeams">Teams</a></li>
            <li><a asp-controller="Odds" asp-action="NFL">Odds</a></li>
            <li><a asp-controller="Scores" asp-action="League" asp-route-league="NFL">Scores</a></li>
            <li><a asp-controller="ExpertPicks" asp-action="Index" asp-route-league="NFL">Experts</a></li>
        </ul>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <!-- LEFT: hero feature + games -->
        <div class="col-lg-8">
            @if (featured != null)
            {
                <a class="nfl-hero" href="@featured.ArticleUrl" target="_blank" rel="noopener"
                   style="@(string.IsNullOrWhiteSpace(featured.ImageUrl) ? "" : $"background-image:linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.85) 100%), url('{featured.ImageUrl}');")">
                    <div class="nfl-hero__badge">
                        <img src="@Model.LeagueLogo" alt="NFL" />
                        <span>NFL HEADLINE</span>
                    </div>
                    <div class="nfl-hero__content">
                        <h2 class="nfl-hero__title">@featured.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(featured.Excerpt))
                        {
                            <p class="nfl-hero__excerpt">@featured.Excerpt</p>
                        }
                        <span class="nfl-hero__meta">@featured.PublishedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                    </div>
                </a>
            }

            <!-- Today's games -->
            <div class="nfl-games">
                <div class="nfl-games__title">
                    <span>Scoreboard</span>
                    <small class="text-muted">@Model.SelectedDateDisplay</small>
                </div>

                @if (Model.Games.Any())
                {
                    <div class="nfl-games__grid">
                        @foreach (var game in Model.Games)
                        {
                            <div class="nfl-game-card">
                                <div class="nfl-game-card__status @(game.IsLive ? "is-live" : "")">
                                    @(string.IsNullOrWhiteSpace(game.StatusDetail) ? (game.IsFinal ? "Final" : game.GameTimeDisplay) : game.StatusDetail)
                                </div>
                                <div class="nfl-game-card__row">
                                    <div class="nfl-game-card__team">
                                        <img src="@game.AwayTeamLogo" alt="@game.AwayTeamName" />
                                        <span>@game.AwayTeamName</span>
                                    </div>
                                    <span class="nfl-game-card__score">@(game.AwayScore?.ToString() ?? "")</span>
                                </div>
                                <div class="nfl-game-card__row">
                                    <div class="nfl-game-card__team">
                                        <img src="@game.HomeTeamLogo" alt="@game.HomeTeamName" />
                                        <span>@game.HomeTeamName</span>
                                    </div>
                                    <span class="nfl-game-card__score">@(game.HomeScore?.ToString() ?? "")</span>
                                </div>
                                <div class="mt-2 text-end">
                                    @if (hasGameSimulationAccess)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="GameSimulation" asp-action="Start"
                                           asp-route-homeTeam="@game.HomeTeamName" asp-route-awayTeam="@game.AwayTeamName" asp-route-league="NFL">
                                            Simulate Game
                                        </a>
                                    }
                                    else if (SignInManager.IsSignedIn(User))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-controller="Membership" asp-action="Join">
                                            $ Game Simulation
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">
                                            $ Game Simulation
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="nfl-games__empty">
                        <img src="@Model.LeagueLogo" alt="NFL" />
                        <p class="mb-0 text-muted">No NFL games scheduled for today. Check back on game day.</p>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: headlines + quick links -->
        <div class="col-lg-4">
            <div class="nfl-headlines">
                <div class="nfl-headlines__title">Top Headlines</div>
                @if (Model.SecondaryHeadlines.Any())
                {
                    <ul class="nfl-headlines__list">
                        @foreach (var item in Model.SecondaryHeadlines)
                        {
                            <li>
                                <a href="@item.ArticleUrl" target="_blank" rel="noopener">@item.Title</a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">Headlines are unavailable right now.</p>
                }
            </div>

            <div class="nfl-quicklinks">
                <div class="nfl-quicklinks__title">Quick Links</div>
                <ul>
                    <li><a asp-controller="NFL" asp-action="AllTeams"><i class="fas fa-football-ball"></i>NFL Teams</a></li>
                    <li><a asp-controller="Odds" asp-action="NFL"><i class="fas fa-percent"></i>NFL Odds</a></li>
                    <li><a asp-controller="ExpertPicks" asp-action="Index" asp-route-league="NFL"><i class="fas fa-user-tie"></i>Expert Picks</a></li>
                    <li><a asp-controller="Scores" asp-action="League" asp-route-league="NFL"><i class="fas fa-list-ol"></i>Scores</a></li>
                    <li><a href="https://www.espn.com/nfl/schedule" target="_blank" rel="noopener"><i class="fas fa-calendar-alt"></i>Full Schedule</a></li>
                    <li><a href="https://www.espn.com/nfl/standings" target="_blank" rel="noopener"><i class="fas fa-list-ol"></i>Standings</a></li>
                </ul>
            </div>  
        </div>
    </div>
</div>

@section Styles {
    <style>
        .nfl-landing__header {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 12px;
            border-bottom: 3px solid var(--primary-blue, #013369);
            padding-bottom: 10px; margin-bottom: 18px;
        }
        .nfl-landing__logo { width: 40px; height: 40px; object-fit: contain; }
        .nfl-landing__title { font-size: 1.9rem; font-weight: 800; color: #0b0c0d; letter-spacing: .5px; }
        .nfl-landing__subnav { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; flex-wrap: wrap; }
        .nfl-landing__subnav a {
            display: inline-block; padding: 8px 14px; color: #444; font-weight: 600;
            text-decoration: none; border-radius: 6px; font-size: .95rem;
        }
        .nfl-landing__subnav a:hover { background: #eef2f6; color: #013369; }
        .nfl-landing__subnav a.active { color: #013369; border-bottom: 3px solid #d50a0a; border-radius: 0; }

        /* Hero feature */
        .nfl-hero {
            display: block; position: relative; min-height: 360px; border-radius: 12px;
            overflow: hidden; text-decoration: none; margin-bottom: 22px;
            background-color: #013369;
            background-size: cover; background-position: center;
            box-shadow: 0 4px 14px rgba(0,0,0,.18);
        }
        .nfl-hero__badge {
            position: absolute; top: 16px; left: 16px; z-index: 2;
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(213,10,10,.95); color: #fff; padding: 5px 12px;
            border-radius: 20px; font-size: .72rem; font-weight: 800; letter-spacing: 1px;
        }
        .nfl-hero__badge img { width: 18px; height: 18px; object-fit: contain; }
        .nfl-hero__content { position: absolute; left: 0; right: 0; bottom: 0; padding: 24px 26px; z-index: 2; }
        .nfl-hero__title { color: #fff; font-size: 1.75rem; font-weight: 800; line-height: 1.2; margin-bottom: 10px; }
        .nfl-hero__excerpt { color: rgba(255,255,255,.9); font-size: 1rem; line-height: 1.45; margin-bottom: 8px;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .nfl-hero__meta { color: rgba(255,255,255,.7); font-size: .8rem; font-weight: 600; text-transform: uppercase; }

        /* Games */
        .nfl-games { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
        .nfl-games__title {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--primary-blue, #013369); color: #fff; padding: 12px 16px;
            font-weight: 800; text-transform: uppercase; letter-spacing: .5px;
        }
        .nfl-games__title small { color: rgba(255,255,255,.75) !important; font-weight: 600; text-transform: none; }
        .nfl-games__grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 14px; padding: 16px;
        }
        .nfl-game-card { border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; background: #fbfcfe; }
        .nfl-game-card__status { font-size: .78rem; font-weight: 700; color: #6b7280; text-transform: uppercase; margin-bottom: 8px; }
        .nfl-game-card__status.is-live { color: #d50a0a; }
        .nfl-game-card__row { display: flex; align-items: center; justify-content: space-between; padding: 4px 0; }
        .nfl-game-card__team { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .nfl-game-card__team img { width: 28px; height: 28px; object-fit: contain; }
        .nfl-game-card__team span { font-weight: 600; color: #111; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .nfl-game-card__score { font-weight: 800; color: #111; font-size: 1.05rem; }
        .nfl-games__empty { text-align: center; padding: 36px 16px; }
        .nfl-games__empty img { width: 54px; height: 54px; opacity: .4; margin-bottom: 10px; }

        /* Headlines */
        .nfl-headlines { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
        .nfl-headlines__title {
            background: var(--primary-blue, #013369); color: #fff; padding: 12px 16px;
            font-weight: 800; text-transform: uppercase; letter-spacing: .5px;
        }
        .nfl-headlines__list { list-style: none; margin: 0; padding: 0; }
        .nfl-headlines__list li { border-bottom: 1px solid #eef2f6; }
        .nfl-headlines__list li:last-child { border-bottom: 0; }
        .nfl-headlines__list a {
            display: block; padding: 12px 16px; color: #111; font-weight: 600;
            font-size: .95rem; line-height: 1.35; text-decoration: none;
        }
        .nfl-headlines__list a:hover { background: #f5f8fb; color: #013369; }

        /* Quick links */
        .nfl-quicklinks { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
        .nfl-quicklinks__title {
            background: #0b0c0d; color: #fff; padding: 12px 16px;
            font-weight: 800; text-transform: uppercase; letter-spacing: .5px;
        }
        .nfl-quicklinks ul { list-style: none; margin: 0; padding: 0; }
        .nfl-quicklinks li { border-bottom: 1px solid #eef2f6; }
        .nfl-quicklinks li:last-child { border-bottom: 0; }
        .nfl-quicklinks a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #111; font-weight: 600; text-decoration: none; }
        .nfl-quicklinks a:hover { background: #f5f8fb; color: #013369; }
        .nfl-quicklinks a i { width: 18px; text-align: center; color: #013369; }
    </style>
}
