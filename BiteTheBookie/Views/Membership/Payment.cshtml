@{
    ViewData["Title"] = "Complete Your Payment";
    var plan = (string)ViewBag.Plan;
    var planName = (string)ViewBag.PlanName;
    var planPrice = (string)ViewBag.PlanPrice;
    var isUpgrade = ViewBag.IsUpgrade is bool b && b;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="selected-tier mb-4">
                <div class="selected-tier__label"><i class="fas fa-lock me-2"></i>Secure Checkout</div>
                <div class="selected-tier__row">
                    <div>
                        <div class="selected-tier__name">@planName Plan</div>
                        <div class="selected-tier__tagline">
                            @(isUpgrade ? "Upgrade your current subscription. Cancel anytime." : "Cancel anytime.")
                        </div>
                    </div>
                    <div class="selected-tier__price">
                        @planPrice<span class="selected-tier__period"> per month</span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-center mb-4">@(isUpgrade ? "Confirm Your Upgrade" : "Complete Your Payment")</h2>

                    @if (TempData["PaymentError"] is string paymentError)
                    {
                        <div class="alert alert-danger" role="alert">@paymentError</div>
                    }

                    <p class="text-center text-muted mb-4">
                        You'll be securely redirected to PayPal to
                        @(isUpgrade ? "approve the change to your subscription." : "approve your subscription.")
                        Once payment is confirmed, PayPal returns you here and your membership is activated.
                    </p>

                    @* Posting to StartCheckout creates/revises the subscription server-side and
                       redirects the browser to PayPal's approval page. *@
                    <form asp-controller="Membership" asp-action="StartCheckout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                            <i class="fab fa-paypal me-2"></i>Continue to PayPal
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="Membership" asp-action="Join" class="selected-tier__change">
                            <i class="fas fa-arrow-left me-1"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
