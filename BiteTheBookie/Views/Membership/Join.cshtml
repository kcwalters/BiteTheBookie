@{
    ViewData["Title"] = "Join BiteTheBookie";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Join BiteTheBookie</h1>
        <p class="lead text-muted">Get expert picks, simulations, and analysis to beat the bookies</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-4">
            <div class="card h-100 pricing-card">
                <div class="card-header text-center py-4">
                    <h3 class="mb-0">Free</h3>
                    <div class="display-5 fw-bold mt-2">$0</div>
                    <div class="text-muted">Forever</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Team pages, schedules &amp; rosters</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Daily matchups &amp; final scores</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Breaking news &amp; injury listings</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Public betting odds &amp; basic stats</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>1 free game simulation per day</li>
                        <li class="mb-3 text-muted"><i class="fas fa-times text-danger me-2"></i>Premium expert picks</li>
                        <li class="mb-3 text-muted"><i class="fas fa-times text-danger me-2"></i>Full simulations &amp; analysis</li>
                    </ul>
                </div>
                <div class="card-footer text-center py-3">
                    <a asp-controller="Membership" asp-action="Register" asp-route-plan="free"
                       class="btn btn-outline-primary btn-lg w-100">
                        Sign Up Free
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 pricing-card pricing-card-featured">
                <div class="card-header text-center py-4 bg-primary text-white">
                    <span class="badge bg-warning text-dark mb-2">MOST POPULAR</span>
                    <h3 class="mb-0 text-white">Pro</h3>
                    <div class="display-5 fw-bold mt-2">$9.99</div>
                    <div class="opacity-75">per month</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Everything in Free</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i><strong>Unlimited game simulations</strong></li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i><strong>Full analysis, win probabilities &amp; projected scores</strong></li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Full blog &amp; matchup analysis</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Advanced fantasy leaderboards &amp; projections</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Up to 5 premium expert picks per week</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Ad-free experience &amp; saved favorites</li>
                    </ul>
                </div>
                <div class="card-footer text-center py-3">
                    <a asp-controller="Membership" asp-action="Register" asp-route-plan="pro"
                       class="btn btn-primary btn-lg w-100">
                        Get Pro
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 pricing-card">
                <div class="card-header text-center py-4">
                    <h3 class="mb-0">All Access</h3>
                    <div class="display-5 fw-bold mt-2">$19.99</div>
                    <div class="text-muted">per month</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Everything in Pro</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i><strong>Every expert pick (Wes, Doug &amp; Justin)</strong></li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i><strong>Moneyline, spread, over/under &amp; player props</strong></li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i><strong>Best-bets, units &amp; confidence levels</strong></li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Advanced simulation &amp; betting-market tools</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Line-movement tracking &amp; best-odds comparison</li>
                        <li class="mb-3"><i class="fas fa-check text-success me-2"></i>Premium articles, member reports &amp; custom alerts</li>
                    </ul>
                </div>
                <div class="card-footer text-center py-3">
                    <a asp-controller="Membership" asp-action="Register" asp-route-plan="allaccess"
                       class="btn btn-dark btn-lg w-100">
                        Go All Access
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pricing-card {
        border-radius: 16px;
        border: 2px solid #dee2e6;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }

    .pricing-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    }

    .pricing-card-featured {
        border-color: #0d6efd;
        transform: scale(1.05);
        box-shadow: 0 8px 30px rgba(13, 110, 253, 0.2);
    }

    .pricing-card-featured:hover {
        transform: scale(1.05) translateY(-8px);
    }

    .pricing-card .card-header {
        border-bottom: none;
    }

    .pricing-card .card-footer {
        background: transparent;
        border-top: none;
    }
</style>