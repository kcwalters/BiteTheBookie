@model BiteTheBookie.ViewModels.MyAccountViewModel

@{
    ViewData["Title"] = "My Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="fw-bold mb-4">My Account</h1>

            <div class="card mb-4">
                <div class="card-header fw-bold">
                    <i class="fas fa-user me-2"></i>Profile
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-4 text-muted">Name</div>
                        <div class="col-sm-8">@Model.FirstName @Model.LastName</div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-sm-4 text-muted">Email</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-sm-4 text-muted">Member Since</div>
                        <div class="col-sm-8">@Model.MemberSince.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-bold">
                    <i class="fas fa-crown me-2"></i>Subscription
                </div>
                <div class="card-body">
                    <div class="row align-items-center mb-3">
                        <div class="col-sm-4 text-muted">Current Plan</div>
                        <div class="col-sm-8">
                            @switch (Model.SubscriptionTier)
                            {
                                case BiteTheBookie.Models.SubscriptionTier.VIP:
                                    <span class="badge bg-dark fs-6">VIP</span>
                                    break;
                                case BiteTheBookie.Models.SubscriptionTier.Premium:
                                    <span class="badge bg-primary fs-6">Premium</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary fs-6">Free</span>
                                    break;
                            }
                        </div>
                    </div>

                    @if (Model.SubscriptionExpiry.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Expires</div>
                            <div class="col-sm-8">
                                @Model.SubscriptionExpiry.Value.ToString("MMMM dd, yyyy")
                                @if (Model.IsPremium)
                                {
                                    <span class="badge bg-success ms-2">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger ms-2">Expired</span>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.SubscriptionTier == BiteTheBookie.Models.SubscriptionTier.Free)
                    {
                        <hr />
                        <div class="text-center">
                            <p class="mb-3">Upgrade to unlock expert picks, AI simulations, and more!</p>
                            <a asp-controller="Membership" asp-action="Join" class="btn btn-primary">
                                <i class="fas fa-arrow-up me-2"></i>Upgrade Now
                            </a>
                        </div>
                    }
                    else if (!Model.IsPremium)
                    {
                        <hr />
                        <div class="text-center">
                            <p class="text-danger mb-3">Your subscription has expired.</p>
                            <a asp-controller="Membership" asp-action="Join" class="btn btn-primary">
                                <i class="fas fa-redo me-2"></i>Renew Subscription
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>