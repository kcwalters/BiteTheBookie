@{
    ViewData["Title"] = "Welcome!";
    var plan = ViewBag.Plan as string ?? "pro";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm p-5">
                <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                <h1 class="fw-bold mt-3">Welcome to BiteTheBookie!</h1>
                <p class="lead text-muted">Your <strong>@plan.ToUpper()</strong> account has been created.</p>
                <hr />
                <p class="text-muted">Payment integration coming soon. For now, enjoy full access!</p>
                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a asp-controller="Picks" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="fas fa-chart-line me-2"></i>View Picks
                    </a>
                    <a asp-controller="Membership" asp-action="MyAccount" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-user me-2"></i>My Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>