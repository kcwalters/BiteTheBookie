@model BiteTheBookie.Models.GameSimulation

@{
    ViewData["Title"] = $"{Model.AwayTeamName} @ {Model.HomeTeamName} - Simulation";
    var today = DateTime.UtcNow.Date;
}

<div class="container py-4 simulation-page">
    <div class="content-card simulation-shell mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <div class="simulation-kicker">Saved Game Simulation</div>
                <h1 class="simulation-title mb-2">@Model.AwayTeamName @@ @Model.HomeTeamName</h1>
                <div class="simulation-meta">
                    <span class="simulation-badge">@Model.League</span>
                    <span class="simulation-meta__text">
                        @Model.GameDate.ToString("MMM d, yyyy")
                        &middot;
                        @if (Model.GameDate.Date < today)
                        {
                            <span class="badge bg-secondary">Past</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Upcoming</span>
                        }
                    </span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Admin" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="simulation-shell">
            @if (string.IsNullOrWhiteSpace(Model.SimulationContent))
            {
                <div class="alert alert-warning mb-0">
                    <p class="mb-0">No simulation content is available for this record.</p>
                </div>
            }
            else
            {
                <div class="simulation-content markdown-content">
                    @Html.Raw(Model.SimulationContent)
                </div>
            }
        </div>

        <div class="text-muted small mt-4 pt-3 border-top">
            <i class="fas fa-database me-1"></i>
            Generated @Model.GeneratedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
            &middot; Game Id: <code>@Model.GameId</code>
        </div>
    </div>
</div>
