@model BiteTheBookie.ViewModels.GameSimulationViewModel
@{
    ViewData["Title"] = $"{Model.AwayTeam} vs {Model.HomeTeam} - Game Simulation";
}

<div class="container py-4 simulation-page">
    <div class="content-card simulation-shell mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <div class="simulation-kicker">AI Game Simulation</div>
                <h1 class="simulation-title mb-2">@Model.AwayTeam vs @Model.HomeTeam</h1>
                <div class="simulation-meta">
                    <span class="simulation-badge">@Model.League</span>
                    <span class="simulation-meta__text">Rendered inside the BiteTheBookie site layout</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Picks" asp-action="Index" class="btn btn-outline-secondary btn-sm simulation-back-btn">
                    <i class="fas fa-list me-1"></i> View Picks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="content-card simulation-shell">
            <div class="alert alert-danger mb-0">
                <h5 class="alert-heading mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Simulation Unavailable</h5>
                <p class="mb-0">@Model.ErrorMessage</p>
            </div>
        </div>
    }
    else
    {
        @if (Model.IsFromCache && Model.CachedAt.HasValue)
        {
            <div class="simulation-notice mb-3">
                <i class="fas fa-database me-2"></i>
                Loaded from cache at @Model.CachedAt.Value.ToLocalTime().ToString("h:mm tt")
                <a class="ms-2" href="@Url.Action("Start", "GameSimulation", new { homeTeam = Model.HomeTeam, awayTeam = Model.AwayTeam, league = Model.League })">regenerate</a>
            </div>
        }

        <div class="content-card simulation-shell">
            @if (string.IsNullOrWhiteSpace(Model.SimulationContent))
            {
                <div class="alert alert-warning mb-0">
                    <p class="mb-0">No simulation content is available yet.</p>
                </div>
            }
            else
            {
                <div class="simulation-content markdown-content">
                    @Html.Raw(Model.SimulationContent)
                </div>
            }
        </div>

        <div class="simulation-actions mt-4">
            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a href="@Url.Action("Start", "GameSimulation", new { homeTeam = Model.HomeTeam, awayTeam = Model.AwayTeam, league = Model.League })"
                   class="btn btn-primary btn-lg simulation-actions__primary">
                    <i class="fas fa-sync-alt me-1"></i> Regenerate Simulation
                </a>
                <a asp-controller="Scores" asp-action="League" asp-route-league="@Model.League"
                   class="btn btn-outline-secondary btn-lg simulation-actions__secondary">
                    <i class="fas fa-chart-bar me-1"></i> Back to Scores
                </a>
            </div>
        </div>
    }
</div>
