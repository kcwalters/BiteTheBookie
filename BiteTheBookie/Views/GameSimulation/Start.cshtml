@model BiteTheBookie.ViewModels.GameSimulationViewModel
@{
    ViewData["Title"] = $"{Model.AwayTeam} vs {Model.HomeTeam} - Game Simulation";
}

<div class="container py-4 simulation-page">
    <div class="content-card simulation-shell mb-4">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <div class="simulation-kicker">AI Game Simulation</div>
                <h1 class="simulation-title mb-2">@Model.AwayTeam vs @Model.HomeTeam</h1>
                <div class="simulation-meta">
                    <span class="simulation-badge">@Model.League</span>
                    <span class="simulation-meta__text">Rendered inside the BiteTheBookie site layout</span>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Picks" asp-action="Index" class="btn btn-outline-secondary btn-sm simulation-back-btn">
                    <i class="fas fa-list me-1"></i> View Picks
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="content-card simulation-shell">
            <div class="alert alert-danger mb-0">
                <h5 class="alert-heading mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Simulation Unavailable</h5>
                <p class="mb-0">@Model.ErrorMessage</p>
            </div>
        </div>
    }
    else
    {
        <div class="content-card">
            <partial name="_SimulationResult" model="Model" />
        </div>
    }
</div>
