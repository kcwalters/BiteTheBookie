@model IEnumerable<BiteTheBookie.ViewModels.NBAOddsViewModel>

@{
    ViewData["Title"] = "NBA Odds";
}

<div class="container py-4">
    <h2 class="mb-4">NBA Odds</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p class="mb-0">No NBA odds available at this time. Please check back later or ensure your Odds API key is configured.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Game</th>
                        <th>Time</th>
                        <th>Moneyline</th>
                        <th>Spread</th>
                        <th>Total</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@game.AwayTeam</div>
                                <div class="text-muted">&#64; @game.HomeTeam</div>
                            </td>
                            <td>
                                @game.CommenceTime.ToLocalTime().ToString("MMM dd, h:mm tt")
                            </td>
                            <td>
                                <div>@game.AwayTeam: <span class="badge bg-primary">@game.AwayMoneyline</span></div>
                                <div>@game.HomeTeam: <span class="badge bg-primary">@game.HomeMoneyline</span></div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(game.AwaySpread))
                                {
                                    <div>@game.AwayTeam: <span class="badge bg-success">@game.AwaySpread (@game.AwaySpreadPrice)</span></div>
                                }
                                @if (!string.IsNullOrEmpty(game.HomeSpread))
                                {
                                    <div>@game.HomeTeam: <span class="badge bg-success">@game.HomeSpread (@game.HomeSpreadPrice)</span></div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(game.OverPoint))
                                {
                                    <div>O @game.OverPoint: <span class="badge bg-warning text-dark">@game.OverPrice</span></div>
                                }
                                @if (!string.IsNullOrEmpty(game.UnderPoint))
                                {
                                    <div>U @game.UnderPoint: <span class="badge bg-warning text-dark">@game.UnderPrice</span></div>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@game.Bookmaker</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted small">
                <strong>Note:</strong> Odds are provided by @Model.FirstOrDefault()?.Bookmaker and are updated periodically. 
                Please verify odds with your sportsbook before placing bets.
            </p>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Odds" asp-action="Index" class="btn btn-secondary">Back to Odds</a>
    </div>
</div>
