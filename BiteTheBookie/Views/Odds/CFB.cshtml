@using BiteTheBookie.Helpers
@model IEnumerable<BiteTheBookie.ViewModels.CFBOddsViewModel>

@{
    ViewData["Title"] = "College Football Odds";
}

<div class="container py-4">
    <h2 class="mb-4">College Football Odds</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p class="mb-0">No College Football odds available at this time. Please check back later or ensure your Odds API key is configured.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover odds-table">
                <thead class="table-dark">
                    <tr>
                        <th>Game</th>
                        <th>Time</th>
                        <th class="odds-column">Moneyline</th>
                        <th class="odds-column">Spread</th>
                        <th class="odds-column">Total</th>
                        <th>Source</th>
                        <th class="text-end">Simulation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model)
                    {
                        <tr data-href="https://sportsbook.draftkings.com/leagues/football/ncaaf" onclick="window.open(this.dataset.href, '_blank')">
                            <td>
                                <div class="fw-bold">@game.AwayTeam</div>
                                <div class="text-muted">&#64; @game.HomeTeam</div>
                            </td>
                            <td>
                                @VenueTimeZoneHelper.FormatVenueTime(game.CommenceTime, game.VenueTimeZoneId)
                            </td>
                            <td class="odds-column">
                                <div class="odds-row">
                                    <div class="odds-item">
                                        <span class="team-label">@game.AwayTeam:</span>
                                        <span class="badge bg-primary">@game.AwayMoneyline</span>
                                    </div>
                                    <div class="odds-item">
                                        <span class="team-label">@game.HomeTeam:</span>
                                        <span class="badge bg-primary">@game.HomeMoneyline</span>
                                    </div>
                                </div>
                            </td>
                            <td class="odds-column">
                                <div class="odds-row">
                                    @if (!string.IsNullOrEmpty(game.AwaySpread))
                                    {
                                        <div class="odds-item">
                                            <span class="team-label">@game.AwayTeam:</span>
                                            <span class="badge bg-success">@game.AwaySpread (@game.AwaySpreadPrice)</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(game.HomeSpread))
                                    {
                                        <div class="odds-item">
                                            <span class="team-label">@game.HomeTeam:</span>
                                            <span class="badge bg-success">@game.HomeSpread (@game.HomeSpreadPrice)</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="odds-column">
                                <div class="odds-row">
                                    @if (!string.IsNullOrEmpty(game.OverPoint))
                                    {
                                        <div class="odds-item">
                                            <span class="team-label">O @game.OverPoint:</span>
                                            <span class="badge bg-warning text-dark">@game.OverPrice</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(game.UnderPoint))
                                    {
                                        <div class="odds-item">
                                            <span class="team-label">U @game.UnderPoint:</span>
                                            <span class="badge bg-warning text-dark">@game.UnderPrice</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@game.Bookmaker</small>
                            </td>
                            <td class="text-end" onclick="event.stopPropagation();">
                                @await Html.PartialAsync("Partials/_SimulationLink", new BiteTheBookie.ViewModels.SimulationLinkViewModel
                                {
                                    GameId = game.GameId,
                                    League = "CFB",
                                    HomeTeam = game.HomeTeam,
                                    AwayTeam = game.AwayTeam
                                })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <p class="text-muted small">
                <strong>Note:</strong> Odds are provided by @Model.FirstOrDefault()?.Bookmaker and are updated periodically. 
                Please verify odds with your sportsbook before placing bets.
            </p>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Odds" asp-action="Index" class="btn btn-secondary">Back to Odds</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/home-page.js" asp-append-version="true"></script>
}
