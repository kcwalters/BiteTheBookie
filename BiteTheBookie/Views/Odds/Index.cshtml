@model BiteTheBookie.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container py-3">
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="content-card">
            </div>
        </div>
        <div class="col-12 col-lg-4">
        </div>

        <div class="col-12">
            <div class="content-card">
                <div class="section-header">Live Odds</div>
                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    @await Html.PartialAsync("~/Views/Shared/Partials/_LiveOddsWidget.cshtml", Model.LiveOdds)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home-page.js" asp-append-version="true"></script>
}